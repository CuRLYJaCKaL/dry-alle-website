---
import config from '../../config/site.config.json';
import { validateConfig } from '../utils/engine';
validateConfig(config as Record<string, unknown>);
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown>;
  ogImage?: string;
  breadcrumbs?: { name: string; url: string }[];
  ogType?: string;
  articleMeta?: { publishedTime?: string; modifiedTime?: string; author?: string };
}

const { title, description, canonicalPath = '', jsonLd, ogImage, breadcrumbs, ogType, articleMeta } = Astro.props;
const canonicalUrl = `https://${config.contact.domain}${canonicalPath}`;
const gtmId: string | undefined = config.analytics?.gtmId;
const ga4Id: string | undefined = config.analytics?.ga4Id;
---

<!DOCTYPE html>
<html lang="tr" dir="ltr">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      jsonLd={jsonLd}
      ogImage={ogImage}
      breadcrumbs={breadcrumbs}
      ogType={ogType}
      articleMeta={articleMeta}
    />
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        // GTM'i ilk kullanici etkilesimine ya da idle'a ertele — LCP/TBT'yi bloklamaz,
        // analytics yine saniyeler icinde devreye girer. (interaction-delay pattern)
        (function (w, d, i) {
          w.dataLayer = w.dataLayer || [];
          var loaded = false;
          function loadGTM() {
            if (loaded) return;
            loaded = true;
            w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName('script')[0];
            var j = d.createElement('script');
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
            f.parentNode.insertBefore(j, f);
            evts.forEach(function (e) { w.removeEventListener(e, loadGTM); });
          }
          var evts = ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'];
          evts.forEach(function (e) { w.addEventListener(e, loadGTM, { once: true, passive: true }); });
          // Etkilesim olmazsa da fallback: sayfa yuklendikten 3.5sn sonra yukle.
          if (d.readyState === 'complete') { setTimeout(loadGTM, 3500); }
          else { w.addEventListener('load', function () { setTimeout(loadGTM, 3500); }, { once: true }); }
        })(window, document, gtmId);
      </script>
    )}
    {ga4Id && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
      <script is:inline define:vars={{ ga4Id }}>
        // GA4 (gtag.js) — async yuklenir, render'i bloklamaz. Sayfa goruntulemesi
        // aninda kaydedilir ki hizli cikan ziyaretciler de sayilsin (dogru trafik verisi).
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        // Astro `define:vars` scripti bir IIFE'ye sarar; gtag'i global'e ac ki
        // donusum olayi listener'i (ve diger kodlar) window.gtag'e erisebilsin.
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', ga4Id);
      </script>
      <script is:inline>
        // Dönüşüm olayları — delege tek listener: tel: → call_click,
        // wa.me → whatsapp_click, mailto: → email_click.
        // GA4 tel:'i otomatik ölçmez; wa.me outbound ile karışır — bu net ayırır.
        // Her olay cta_placement parametresiyle gönderilir (sticky/header/footer/content).
        function initGa4ConversionEvents() {
          var root = document.documentElement;
          if (root.dataset.ga4EventsInitialized) return;
          root.dataset.ga4EventsInitialized = 'true';

          function track(name, params) {
            if (typeof window.gtag === 'function') {
              window.gtag('event', name, params || {});
            }
          }

          // Butonun sayfadaki yeri: sabit WhatsApp balonu mu, header/footer mi,
          // icerik icindeki CTA mi? Hangi konumun donusturdugunu ayirt eder.
          function placement(link) {
            if (link.closest('#whatsapp-cta')) return 'sticky';
            if (link.closest('header')) return 'header';
            if (link.closest('footer')) return 'footer';
            return 'content';
          }

          document.addEventListener('click', function (e) {
            var link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!link) return;
            var href = link.getAttribute('href') || '';
            if (href.indexOf('tel:') === 0) {
              track('call_click', { link_url: href, cta_placement: placement(link) });
            } else if (href.indexOf('wa.me') !== -1) {
              track('whatsapp_click', { link_url: href, cta_placement: placement(link) });
            } else if (href.indexOf('mailto:') === 0) {
              track('email_click', { link_url: href, cta_placement: placement(link) });
            }
          }, true);

          // order_submit burada DEGIL, siparis sayfasinda tetiklenir: form gonderimi
          // sayfanin kendi dogrulamasindan gecip WhatsApp'a iletildigi an sayilmali,
          // yoksa iletilmeyen denemeler de donusum olarak sayiliyordu.
        }

        document.addEventListener('astro:page-load', initGa4ConversionEvents);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initGa4ConversionEvents);
        } else {
          initGa4ConversionEvents();
        }
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        ></iframe>
      </noscript>
    )}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-elevated">
      İçeriğe Geç
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppCTA />
  </body>
</html>
