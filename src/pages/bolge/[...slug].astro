---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contact from '../../components/Contact.astro';
import FAQ from '../../components/FAQ.astro';
import config from '../../../config/site.config.json';
import { interpolate, deterministicIndex } from '../../utils/engine';

export function getStaticPaths() {
  const paths: { params: { slug: string }; props: Record<string, unknown> }[] = [];

  for (const area of config.serviceAreas) {
    // District page: /bolge/sariyer/
    paths.push({
      params: { slug: area.districtSlug },
      props: {
        district: area,
        neighborhood: null,
        isDistrict: true,
      },
    });

    // Neighborhood pages: /bolge/sariyer/tarabya/
    for (const nh of area.neighborhoods) {
      paths.push({
        params: { slug: `${area.districtSlug}/${nh.slug}` },
        props: {
          district: area,
          neighborhood: nh,
          isDistrict: false,
        },
      });
    }
  }

  // Curated location×service combo pages
  for (const entry of ((config as Record<string, unknown>).serviceAreaPages as Array<Record<string, unknown>> ?? [])) {
    const area = config.serviceAreas.find((a) => a.districtSlug === entry.districtSlug);
    if (!area) continue;
    const service = config.services.find((sv) => sv.slug === entry.serviceSlug);
    if (!service) continue;
    if (entry.neighborhoodSlug) {
      const nh = area.neighborhoods.find((n) => n.slug === entry.neighborhoodSlug);
      if (!nh) continue;
      paths.push({ params: { slug: `${area.districtSlug}/${nh.slug}/${service.slug}` },
        props: { district: area, neighborhood: nh, isDistrict: false, isServicePage: true, service, pageEntry: entry } });
    } else {
      paths.push({ params: { slug: `${area.districtSlug}/${service.slug}` },
        props: { district: area, neighborhood: null, isDistrict: true, isServicePage: true, service, pageEntry: entry } });
    }
  }

  return paths;
}

interface NeighborhoodData {
  name: string;
  slug: string;
}

interface DistrictData {
  city: string;
  district: string;
  districtSlug: string;
  neighborhoods: NeighborhoodData[];
}

const { district, neighborhood, isDistrict } = Astro.props as {
  district: DistrictData;
  neighborhood: NeighborhoodData | null;
  isDistrict: boolean;
};

const locationName = isDistrict ? district.district : neighborhood!.name;
const primaryKeyword = config.seoTokens.primaryKeywords[0];
const businessName = config.identity.businessName;
const sectorLabel = config.identity.sectorLabel;

const primaryKeywordCap = primaryKeyword.charAt(0).toUpperCase() + primaryKeyword.slice(1);
const seoTokens = {
  location: locationName,
  sectorLabel,
  businessName,
  primaryKeyword,
  primaryKeywordCap,
  establishedYear: String(config.identity.establishedYear),
  province: config.contact.address.province,
};

const title = interpolate(config.seoTemplates.regionTitle, seoTokens);
const description = interpolate(config.seoTemplates.regionDescription, seoTokens);
const canonicalPath = isDistrict
  ? `/bolge/${district.districtSlug}/`
  : `/bolge/${district.districtSlug}/${neighborhood!.slug}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `${businessName} - ${locationName}`,
  "description": description,
  "url": `https://${config.contact.domain}${canonicalPath}`,
  "telephone": config.contact.phone,
  "email": config.contact.email,
  "image": `https://${config.contact.domain}/images/logo.png`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": config.contact.address.street,
    "addressLocality": locationName,
    "addressRegion": district.city,
    "postalCode": config.contact.address.postalCode,
    "addressCountry": "TR"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": config.openingHours.days,
      "opens": config.openingHours.opens,
      "closes": config.openingHours.closes
    }
  ],
  "areaServed": {
    "@type": "Place",
    "name": locationName
  },
  ...(Object.values(config.contact.socialLinks || {}).filter(Boolean).length > 0 ? { "sameAs": Object.values(config.contact.socialLinks).filter(Boolean) } : {}),
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `${sectorLabel} Hizmetleri`,
    "itemListElement": config.services.map(service => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": service.name,
        "description": service.description
      }
    }))
  }
};

const services = config.services;
const otherNeighborhoods = district.neighborhoods.filter(
  (n) => !neighborhood || n.slug !== neighborhood.slug
);

const valuePropositions = config.contentTokens.valuePropositions;
const whatsappClean = config.contact.whatsapp.replace(/[\s+]/g, '');
const whatsappUrl = `https://wa.me/${whatsappClean}`;

const vpDetailTexts = config.contentTokens.valuePropositionDetails as string[];
const vpDetails = valuePropositions.map((vpTitle: string, i: number) => ({
  title: vpTitle,
  description: vpDetailTexts[i] || '',
}));

const regionVariants = config.contentTokens.regionVariants as string[];
const regionSubtitleVariants = config.contentTokens.regionSubtitleVariants as string[];
const slugForVariant = isDistrict ? district.districtSlug : `${district.districtSlug}/${neighborhood!.slug}`;
const variantIdx = deterministicIndex(slugForVariant, regionVariants.length);
const heroText = interpolate(regionVariants[variantIdx], seoTokens);
const whySubtitle = interpolate(regionSubtitleVariants[variantIdx], seoTokens);

// ── Lokasyon×Hizmet combo sayfası (isServicePage) ──
const isServicePage = ((Astro.props as Record<string, unknown>).isServicePage as boolean) ?? false;
const service = (Astro.props as Record<string, unknown>).service as { name: string; slug: string; description: string } | undefined;
const pageEntry = (Astro.props as Record<string, unknown>).pageEntry as { intro: string; bodyParagraphs: string[]; faq: Array<{ question: string; answer: string }> } | undefined;
const st = config.seoTemplates as Record<string, string>;
let svcTitle = title, svcDescription = description, svcH1 = '', svcCanonical = canonicalPath;
let svcSchemas: Array<Record<string, unknown>> = [];
if (isServicePage && service && pageEntry) {
  const sTokens = { ...seoTokens, serviceName: service.name, serviceNameLower: service.name.toLocaleLowerCase('tr-TR') };
  svcTitle = interpolate(st.regionServiceTitle, sTokens);
  svcDescription = interpolate(st.regionServiceDescription, sTokens);
  svcH1 = interpolate(st.regionServiceH1, sTokens);
  svcCanonical = neighborhood
    ? `/bolge/${district.districtSlug}/${neighborhood.slug}/${service.slug}/`
    : `/bolge/${district.districtSlug}/${service.slug}/`;
  svcSchemas = [
    { "@type": "Service", "serviceType": service.name,
      "name": `${locationName} ${service.name}`, "description": svcDescription,
      "image": `https://${config.contact.domain}/images/services/${service.slug}.webp`,
      "areaServed": { "@type": "Place", "name": locationName },
      "provider": { "@id": `https://${config.contact.domain}/#business` } },
    { "@type": "FAQPage",
      "mainEntity": pageEntry.faq.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })) },
  ];
}
// Region sayfasında o lokasyona ait combo (lokasyon×hizmet) linkleri
const serviceNameBySlug = new Map(config.services.map((s) => [s.slug, s.name]));
const localCombos = (((config as Record<string, unknown>).serviceAreaPages as Array<{ districtSlug: string; neighborhoodSlug?: string; serviceSlug: string }>) ?? [])
  .filter((e) => e.districtSlug === district.districtSlug && (neighborhood ? e.neighborhoodSlug === neighborhood.slug : !e.neighborhoodSlug));
const regionCombos = localCombos.map((e) => ({
  url: e.neighborhoodSlug ? `/bolge/${e.districtSlug}/${e.neighborhoodSlug}/${e.serviceSlug}/` : `/bolge/${e.districtSlug}/${e.serviceSlug}/`,
  label: `${locationName} ${serviceNameBySlug.get(e.serviceSlug)}`,
}));
// Bu lokasyonda combo'su olan hizmet slug'lari — hizmet karti combo-farkinda link icin
const localComboServiceSlugs = new Set(localCombos.map((e) => e.serviceSlug));
// Hizmet karti hedefi: bu lokasyonda combo varsa combo, yoksa generic hizmet sayfasi
const serviceCardHref = (serviceSlug: string): string =>
  localComboServiceSlugs.has(serviceSlug)
    ? (neighborhood ? `/bolge/${district.districtSlug}/${neighborhood.slug}/${serviceSlug}/` : `/bolge/${district.districtSlug}/${serviceSlug}/`)
    : `/hizmetler/${serviceSlug}/`;

const svcBreadcrumbs = isServicePage && service ? (neighborhood
  ? [ { name: 'Ana Sayfa', url: '/' }, { name: 'Bölgeler', url: '/#bolgeler' },
      { name: district.district, url: `/bolge/${district.districtSlug}/` },
      { name: neighborhood.name, url: `/bolge/${district.districtSlug}/${neighborhood.slug}/` },
      { name: service.name, url: svcCanonical } ]
  : [ { name: 'Ana Sayfa', url: '/' }, { name: 'Bölgeler', url: '/#bolgeler' },
      { name: district.district, url: `/bolge/${district.districtSlug}/` },
      { name: service.name, url: svcCanonical } ]) : [];
---

<BaseLayout
  title={isServicePage ? svcTitle : title}
  description={isServicePage ? svcDescription : description}
  canonicalPath={isServicePage ? svcCanonical : canonicalPath}
  ogImage={isServicePage && service ? `/images/services/${service.slug}.webp` : undefined}
  jsonLd={isServicePage ? svcSchemas : undefined}
  breadcrumbs={isServicePage ? svcBreadcrumbs : (isDistrict
    ? [
        { name: 'Ana Sayfa', url: '/' },
        { name: 'Bölgeler', url: '/#bolgeler' },
        { name: district.district, url: `/bolge/${district.districtSlug}/` }
      ]
    : [
        { name: 'Ana Sayfa', url: '/' },
        { name: 'Bölgeler', url: '/#bolgeler' },
        { name: district.district, url: `/bolge/${district.districtSlug}/` },
        { name: neighborhood!.name, url: `/bolge/${district.districtSlug}/${neighborhood!.slug}/` }
      ])
  }
>

  {isServicePage && service && pageEntry && (
    <Fragment>

      <!-- Combo HERO -->
      <section class="relative overflow-hidden bg-gradient-to-br from-primary to-primary-dark text-white pt-8 sm:pt-10 lg:pt-12 pb-14 sm:pb-16 lg:pb-20">
        <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
          <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent rounded-full blur-3xl translate-x-1/3 -translate-y-1/3"></div>
        </div>
        <div class="section-container relative z-10 max-w-4xl">
          <nav class="mb-6 text-sm text-white/85" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-2">
              <li><a href="/" class="hover:text-white transition-colors">Ana Sayfa</a></li>
              <li aria-hidden="true">›</li>
              <li><a href={`/bolge/${district.districtSlug}/`} class="hover:text-white transition-colors">{district.district}</a></li>
              {neighborhood && (<><li aria-hidden="true">›</li><li><a href={`/bolge/${district.districtSlug}/${neighborhood.slug}/`} class="hover:text-white transition-colors">{neighborhood.name}</a></li></>)}
              <li aria-hidden="true">›</li>
              <li class="text-white font-medium">{service.name}</li>
            </ol>
          </nav>
          <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-6 text-accent-light text-sm font-medium">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            İstanbul / {district.district}{neighborhood ? ` / ${neighborhood.name}` : ''}
          </div>
          <h1 class="text-hero font-bold mb-5">{svcH1}</h1>
          <p class="text-lg sm:text-xl text-white/90 mb-8 max-w-3xl">{pageEntry.intro}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={`tel:${config.contact.phone.replace(/\s/g, '')}`} class="btn-primary"><svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>Hemen Arayın: {config.contact.phoneDisplay}</a>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">WhatsApp ile Yazın</a>
          </div>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-8 text-sm text-white/80">
            {(config.contentTokens.serviceHighlights as string[]).map((h) => (<span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{h}</span>))}
          </div>
        </div>
      </section>

      <!-- Combo BODY -->
      <section class="section-padding bg-white">
        <div class="section-container max-w-4xl">
          <img
            src={`/images/services/${service.slug}.webp`}
            alt={`${locationName} ${service.name} — ${businessName} profesyonel hizmet`}
            width="1200"
            height="675"
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl shadow-card mb-8 aspect-[16/9] object-cover"
          />
          {pageEntry.bodyParagraphs.map((para) => (<p class="text-text-primary text-base sm:text-lg leading-relaxed mb-5">{para}</p>))}
          <div class="mt-8 flex flex-col sm:flex-row gap-4 p-6 bg-surface rounded-2xl border border-border/50">
            <div class="flex-1">
              <h2 class="text-xl font-bold text-primary mb-1">{service.name} fiyatını mı merak ediyorsunuz?</h2>
              <p class="text-text-secondary text-sm">Güncel fiyat listemize bakın veya {service.name.toLocaleLowerCase('tr-TR')} için fotoğrafınızı WhatsApp'tan gönderin, dakikalar içinde net fiyat alın.</p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <a href="/fiyatlar/" class="btn-primary whitespace-nowrap">Fiyat Listesi</a>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp whitespace-nowrap">WhatsApp</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Combo FAQ (ozgun, FAQPage rich-result) -->
      <section class="section-padding bg-surface">
        <div class="section-container max-w-4xl">
          <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-8">Sıkça Sorulan Sorular</h2>
          <div class="space-y-3">
            {pageEntry.faq.map((item) => (
              <details class="group bg-white rounded-xl border border-border/50 overflow-hidden">
                <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none list-none min-h-[44px] font-semibold text-primary hover:bg-surface/50 transition-colors [&::-webkit-details-marker]:hidden">
                  <span>{item.question}</span>
                  <svg class="w-5 h-5 shrink-0 text-accent transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="px-5 pb-5 pt-1 text-text-primary leading-relaxed">{item.answer}</div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Ic linkler -->
      <section class="py-12 bg-white">
        <div class="section-container max-w-4xl">
          <h2 class="text-2xl font-bold text-primary mb-6">İlgili Sayfalar</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a href={`/hizmetler/${service.slug}/`} class="flex items-center gap-3 bg-surface/50 rounded-xl px-4 py-3.5 border border-border/60 hover:border-accent/40 hover:bg-white transition-all"><span class="text-sm font-semibold text-primary">{service.name} — Hizmet Detayı</span></a>
            <a href={`/bolge/${district.districtSlug}/`} class="flex items-center gap-3 bg-surface/50 rounded-xl px-4 py-3.5 border border-border/60 hover:border-accent/40 hover:bg-white transition-all"><span class="text-sm font-semibold text-primary">{district.district} — Tüm Hizmetler</span></a>
            {neighborhood && (<a href={`/bolge/${district.districtSlug}/${neighborhood.slug}/`} class="flex items-center gap-3 bg-surface/50 rounded-xl px-4 py-3.5 border border-border/60 hover:border-accent/40 hover:bg-white transition-all"><span class="text-sm font-semibold text-primary">{neighborhood.name} — Bölge Sayfası</span></a>)}
            <a href="/fiyatlar/" class="flex items-center gap-3 bg-surface/50 rounded-xl px-4 py-3.5 border border-border/60 hover:border-accent/40 hover:bg-white transition-all"><span class="text-sm font-semibold text-primary">Güncel Fiyat Listesi</span></a>
          </div>
        </div>
      </section>

      <Contact />
    </Fragment>
  )}

  {!isServicePage && (
  <Fragment>
  <!-- ===================== HERO SECTION ===================== -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary to-primary-dark pt-8 sm:pt-10 lg:pt-12 pb-12 sm:pb-16 lg:pb-20">
    <!-- Decorative background blobs -->
    <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent rounded-full blur-3xl translate-x-1/3 -translate-y-1/3"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-secondary rounded-full blur-3xl -translate-x-1/4 translate-y-1/4"></div>
      <div class="absolute top-1/2 left-1/2 w-[300px] h-[300px] bg-accent-light rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2 opacity-50"></div>
    </div>

    <!-- Subtle grid pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true"
         style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;">
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-4xl">
        <!-- Breadcrumb with icon -->
        <nav class="mb-6" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-white/85">
            <li>
              <a href="/" class="inline-flex items-center gap-1.5 hover:text-white/80 transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                Ana Sayfa
              </a>
            </li>
            <li>
              <svg class="w-3.5 h-3.5 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </li>
            {!isDistrict && (
              <>
                <li>
                  <a href={`/bolge/${district.districtSlug}/`} class="hover:text-white/80 transition-colors">
                    {district.district}
                  </a>
                </li>
                <li>
                  <svg class="w-3.5 h-3.5 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                </li>
              </>
            )}
            <li class="text-white/90 font-medium">{locationName}</li>
          </ol>
        </nav>

        <!-- Location badge -->
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-6 text-accent-light text-sm font-medium">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {district.city} / {district.district}{!isDistrict && ` / ${locationName}`}
        </div>

        <h1 class="text-hero font-heading font-bold text-white mb-6 leading-tight">
          {interpolate(config.seoTemplates.regionH1, seoTokens)}
        </h1>

        <p class="text-lg sm:text-xl text-white/80 max-w-3xl mb-10 leading-relaxed">
          {heroText}
          {isDistrict
            ? ` ${district.district} genelinde tüm mahallelerde kapınıza geliyoruz.`
            : ` ${neighborhood!.name} ve ${district.district} genelinde kapınıza geliyoruz.`}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#iletisim" class="btn-primary text-base sm:text-lg px-8 py-4">
            {config.conversionTokens.primaryCTA}
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp text-base sm:text-lg px-8 py-4 gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            {config.conversionTokens.secondaryCTA}
          </a>
        </div>

        <!-- Service highlights -->
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-white/60 text-sm">
          {(config.contentTokens.serviceHighlights as string[]).map((highlight: string, i: number) => (
