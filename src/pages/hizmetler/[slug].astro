---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import Contact from '../../components/Contact.astro';
import config from '../../../config/site.config.json';
import { interpolate } from '../../utils/engine';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return config.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface ServiceData {
  name: string;
  slug: string;
  description: string;
  icon: string;
  features?: string[];
  detailParagraphs?: string[];
  relatedBlogSlugs?: string[];
}

const { service } = Astro.props as { service: ServiceData };
const businessName = config.identity.businessName;
const province = config.contact.address.province;
const neighborhoodCount = config.serviceAreas.reduce(
  (sum: number, area: { neighborhoods: unknown[] }) => sum + area.neighborhoods.length, 0
);

const seoTokens = {
  serviceName: service.name,
  serviceNameLower: service.name.toLowerCase(),
  businessName,
  province,
  sectorLabel: config.identity.sectorLabel,
};

// Hizmet-basina ozel SEO override (GSC fine-tune) — yoksa sablon.
const svcOverride = service as { seoTitle?: string; seoDescription?: string; faq?: Array<{ question: string; answer: string }> };
const title = svcOverride.seoTitle || interpolate(config.seoTemplates.serviceTitle, seoTokens);
const description = svcOverride.seoDescription || interpolate(config.seoTemplates.serviceDescription, seoTokens);
const serviceFaq = svcOverride.faq ?? [];
// Gercek fiyat tablosu (halı/koltuk/perde/yorgan) — config.pricing.servicePriceTables'tan.
const svcPriceTable = (config.pricing?.servicePriceTables as Record<string, { unit: string; unitNote?: string; items: Array<{ name: string; price: number }> }> | undefined)?.[service.slug];
const svcPriceUnitSuffix = svcPriceTable?.unit === 'm²' ? ' / m²' : '';
const svcPriceYear = new Date().getFullYear();
const canonicalPath = `/hizmetler/${service.slug}/`;

const jsonLd = {
  "@type": "Service",
  "name": `${service.name} - ${businessName}`,
  "description": description,
  "serviceType": service.name,
  "url": `https://${config.contact.domain}${canonicalPath}`,
  "image": `https://${config.contact.domain}/images/logo.png`,
  "provider": { "@id": `https://${config.contact.domain}/#business` },
  "areaServed": config.serviceAreas.map(area => ({
    "@type": "Place",
    "name": `${area.district}, ${area.city}`
  }))
};

// service.faq varsa FAQPage semasini grafige ekle (motor: jsonLd dizi olur)
const faqSchema = serviceFaq.length > 0 ? {
  "@type": "FAQPage",
  "mainEntity": serviceFaq.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })),
} : null;
const finalJsonLd = faqSchema ? [jsonLd, faqSchema] : jsonLd;

const areas = config.serviceAreas;

// Bu hizmet için öne çıkan bölge (combo) sayfaları
const districtNameBySlug = new Map(config.serviceAreas.map((a) => [a.districtSlug, a.district]));
const nhNameBySlug = new Map(config.serviceAreas.flatMap((a) => a.neighborhoods.map((n) => [n.slug, n.name] as const)));
const serviceAreaPages = ((config as Record<string, unknown>).serviceAreaPages as Array<{ districtSlug: string; neighborhoodSlug?: string; serviceSlug: string }>) ?? [];
const featuredComboAreas = serviceAreaPages
  .filter((e) => e.serviceSlug === service.slug)
  .map((e) => ({
    url: e.neighborhoodSlug ? `/bolge/${e.districtSlug}/${e.neighborhoodSlug}/${e.serviceSlug}/` : `/bolge/${e.districtSlug}/${e.serviceSlug}/`,
    label: `${e.neighborhoodSlug ? nhNameBySlug.get(e.neighborhoodSlug) : districtNameBySlug.get(e.districtSlug)} ${service.name}`,
  }));

// Hizmet-farkında bölge linki: bu hizmet için combo sayfası varsa oraya, yoksa genel bölge hub'ına.
const serviceComboKeys = new Set(
  serviceAreaPages
    .filter((e) => e.serviceSlug === service.slug)
    .map((e) => (e.neighborhoodSlug ? `${e.districtSlug}/${e.neighborhoodSlug}` : e.districtSlug))
);
// Bu hizmet icin o lokasyonda combo (hizmet-ozel sayfa) var mi?
const hasServiceCombo = (districtSlug: string, nhSlug?: string): boolean =>
  serviceComboKeys.has(nhSlug ? `${districtSlug}/${nhSlug}` : districtSlug);
// Her zaman gecerli bir link dondur (tutarli/tiklanabilir): nh combo -> ilce combo -> bolge sayfasi.
const areaServiceHref = (districtSlug: string, nhSlug?: string): string => {
  if (hasServiceCombo(districtSlug, nhSlug)) return nhSlug ? `/bolge/${districtSlug}/${nhSlug}/${service.slug}/` : `/bolge/${districtSlug}/${service.slug}/`;
  if (nhSlug && hasServiceCombo(districtSlug)) return `/bolge/${districtSlug}/${service.slug}/`;
  return nhSlug ? `/bolge/${districtSlug}/${nhSlug}/` : `/bolge/${districtSlug}/`;
};
// Bu hizmetin combo'su olan ilce sayisi (grid'i akilli gostermek icin)
const serviceHasAnyCombo = serviceComboKeys.size > 0;

const { googleRating, reviewCount } = config.socialProof;
const testimonials = config.socialProof.testimonials;
const whatsappClean = config.contact.whatsapp.replace(/[\s+]/g, '');
const whatsappUrl = `https://wa.me/${whatsappClean}`;

/* Service-specific icon map (inline SVGs for each service type) */
const serviceIcons: Record<string, string> = {
  shirt: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />`,
  iron: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42" />`,
  curtain: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125Z" />`,
  carpet: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 7.125C2.25 6.504 2.754 6 3.375 6h6c.621 0 1.125.504 1.125 1.125v3.75c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 0 1-1.125-1.125v-3.75ZM14.25 8.625c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v8.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-8.25ZM3.75 16.125c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 0 1-1.125-1.125v-2.25Z" />`,
  suit: `<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />`,
  dress: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />`,
  leather: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />`,
  sofa: `<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />`,
  textile: `<path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />`,
  organic: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />`,
};

const currentIcon = serviceIcons[service.icon] || serviceIcons['shirt'];

const features = service.features || [];

const contentTokens = { businessName, province, sectorLabel: config.identity.sectorLabel };
const content = (service.detailParagraphs || []).map((p: string) => interpolate(p, contentTokens));

const allPosts = await getCollection('blog', ({ data }) => data.date <= new Date().toISOString().slice(0, 10));
const relatedSlugs = service.relatedBlogSlugs || [];
const svcKeyword = service.name.split(' ')[0].toLocaleLowerCase('tr-TR');
const svcSlugKey = service.slug.split('-')[0]; // hali, koltuk, perde, kuru, ev, utu...
const englishSyn: Record<string, string> = { hali: 'carpet', koltuk: 'upholstery', perde: 'curtain', kuru: 'dry-clean', utu: 'iron' };
const engKey = englishSyn[svcSlugKey];
const matchesService = (p: { slug: string; data: { tags?: string[] } }): boolean =>
  (p.data.tags ?? []).some((t: string) => t.toLocaleLowerCase('tr-TR').includes(svcKeyword)) ||
  p.slug.includes(svcSlugKey) ||
  (engKey !== undefined && p.slug.includes(engKey));
const curatedPosts = relatedSlugs
  .map((slug: string) => allPosts.find(p => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);
const taggedPosts = allPosts
  .filter(matchesService)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const seenRelated = new Set<string>();
const relatedPosts = [...curatedPosts, ...taggedPosts]
  .filter(p => { if (seenRelated.has(p.slug)) return false; seenRelated.add(p.slug); return true; })
  .slice(0, 6);
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} jsonLd={finalJsonLd}>

  <!-- ════════════════════════════════════════════
       HERO
       ════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary to-primary-dark text-white pt-8 sm:pt-10 lg:pt-12 pb-12 sm:pb-16 lg:pb-20">
    <!-- Decorative blurred circles (same pattern as homepage hero) -->
    <div class="absolute inset-0 opacity-[0.06]" aria-hidden="true">
      <div class="absolute -top-24 right-0 w-[500px] h-[500px] bg-accent rounded-full blur-3xl translate-x-1/3"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-secondary rounded-full blur-3xl -translate-x-1/4 translate-y-1/4"></div>
      <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-accent rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2 opacity-50"></div>
    </div>

    <!-- Subtle grid pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true"
         style="background-image: radial-gradient(circle, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 32px 32px;">
    </div>

    <div class="section-container relative z-10">
      <!-- Breadcrumb -->
      <nav class="mb-6 animate-fade-in" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-white/70">
          <li>
            <a href="/" class="hover:text-white transition-colors">Ana Sayfa</a>
          </li>
          <li aria-hidden="true">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </li>
          <li>
            <a href="/#hizmetler" class="hover:text-white transition-colors">Hizmetler</a>
          </li>
          <li aria-hidden="true">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </li>
          <li class="text-white font-medium">{service.name}</li>
        </ol>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-center lg:gap-12">
        <!-- Text content -->
        <div class="flex-1 animate-slide-up">
          <span class="badge bg-white/10 text-white/90 backdrop-blur-sm mb-4">
            Uzman Kadro & Modern Ekipman
          </span>

          <h1 class="text-hero font-bold mb-6 leading-tight">
            {service.name}
          </h1>

          <p class="text-lg sm:text-xl text-white/80 max-w-2xl mb-10 leading-relaxed">
            {service.description} {province} ve çevre bölgelerde {config.identity.establishedYear}'den bu yana
            {service.name.toLowerCase()} alanında güvenilir çözümler üretiyoruz.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href={`tel:${config.contact.phone.replace(/\s/g, '')}`} class="btn-primary text-base sm:text-lg px-8 py-4">
              <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {config.conversionTokens.ctaPhone}
            </a>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp text-base sm:text-lg px-8 py-4 gap-2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
              {config.conversionTokens.secondaryCTA}
            </a>
          </div>
        </div>

        <!-- Decorative icon card (right side on large screens) -->
        <div class="hidden lg:flex items-center justify-center animate-fade-in delay-300">
          <div class="relative">
            <div class="absolute inset-0 bg-accent/20 rounded-3xl blur-2xl scale-110" aria-hidden="true"></div>
            <div class="relative bg-white/10 backdrop-blur-sm border border-white/20 rounded-3xl p-12">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-28 h-28 text-white/90" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" set:html={currentIcon} />
            </div>
          </div>
        </div>
      </div>

      <!-- Service highlights -->
      <div class="mt-10 animate-slide-up delay-200">
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-white/60 text-sm">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Ücretsiz Al-Götür
          </span>
          <span class="text-white/20" aria-hidden="true">|</span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Aynı Gün Teslimat
          </span>
          <span class="text-white/20" aria-hidden="true">|</span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Profesyonel Ekipman
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       SERVICE DETAILS
       ════════════════════════════════════════════ -->
  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <!-- Left: text content -->
        <div>
          <h2 class="section-title">{service.name} Hizmetimiz Hakkında</h2>
          <div class="text-text-secondary leading-relaxed space-y-4 mt-8">
            {content.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

        <!-- Right: feature list -->
        <div class="bg-surface rounded-2xl p-8">
          <h3 class="font-bold text-primary text-lg mb-6 flex items-center gap-3">
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-accent/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" />
              </svg>
            </span>
            Bu Hizmette Neden Öne Çıkıyoruz?
          </h3>

          <ul class="space-y-4">
            {features.map((feature) => (
              <li class="flex items-start gap-3">
