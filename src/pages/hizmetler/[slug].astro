          <p class="section-subtitle mx-auto">Bulunduğunuz semte özel {service.name.toLocaleLowerCase('tr-TR')} fiyatları ve detayları için ilgili sayfaya göz atın.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 max-w-4xl mx-auto">
          {featuredComboAreas.map((c) => (
            <a href={c.url} class="group flex items-center gap-3 bg-white rounded-xl px-4 py-3.5 border border-border/60 hover:border-accent/40 hover:shadow-card transition-all">
              <div class="w-9 h-9 shrink-0 rounded-lg bg-accent/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <span class="flex-1 min-w-0 text-sm font-semibold text-primary">{c.label}</span>
              <svg class="w-4 h-4 text-border group-hover:text-accent shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ════════════════════════════════════════════
       FİYAT TABLOSU (gerçek fiyatlar — halı/koltuk/perde/yorgan)
       ════════════════════════════════════════════ -->
  {svcPriceTable && (
    <section class="section-padding bg-white">
      <div class="section-container max-w-3xl">
        <div class="text-center mb-10">
          <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-3">{service.name} Fiyatları {svcPriceYear}</h2>
          <p class="text-text-secondary">{svcPriceTable.unitNote} Tüm fiyatlara ücretsiz kapıdan alım-teslimat dahildir.</p>
        </div>
        <div class="bg-white rounded-2xl border border-border/50 shadow-card overflow-hidden">
          <ul class="divide-y divide-border/40">
            {svcPriceTable.items.map((item) => (
              <li class="flex items-center justify-between gap-4 px-5 sm:px-6 py-4">
                <span class="font-medium text-text-primary">{item.name}</span>
                <span class="font-bold text-primary whitespace-nowrap">{item.price} ₺{svcPriceUnitSuffix}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="text-center mt-8">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp px-8 py-4 text-base">Net fiyat için WhatsApp'tan fotoğraf gönderin</a>
        </div>
      </div>
    </section>
  )}

  <!-- ════════════════════════════════════════════
       FAQ & CONTACT
       ════════════════════════════════════════════ -->
  {serviceFaq.length > 0 ? (
    <section class="section-padding bg-surface">
      <div class="section-container max-w-4xl">
        <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-8">Sıkça Sorulan Sorular</h2>
        <div class="space-y-3">
          {serviceFaq.map((item) => (
            <details class="group bg-white rounded-xl border border-border/50 overflow-hidden">
              <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none list-none min-h-[44px] font-semibold text-primary hover:bg-surface/50 transition-colors [&::-webkit-details-marker]:hidden">
                <span>{item.question}</span>
                <svg class="w-5 h-5 shrink-0 text-accent transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="px-5 pb-5 pt-1 text-text-primary leading-relaxed">{item.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <FAQ />
  )}
  <Contact />
</BaseLayout>
