---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import Contact from '../../components/Contact.astro';
import config from '../../../config/site.config.json';
import { interpolate } from '../../utils/engine';

const businessName = config.identity.businessName;
const sectorLabel = config.identity.sectorLabel;
const province = config.contact.address.province;
const phone = config.contact.phone;
const phoneClean = phone.replace(/\s/g, '');
const whatsappClean = config.contact.whatsapp.replace(/[\s+]/g, '');
const whatsappUrl = `https://wa.me/${whatsappClean}`;

const seoTokens = { businessName, sectorLabel, province };
const title = interpolate(config.seoTemplates.corporateTitle, seoTokens);
const description = interpolate(config.seoTemplates.corporateDescription, seoTokens);
const canonicalPath = '/kurumsal/';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Kurumsal ${sectorLabel} - ${businessName}`,
  "description": description,
  "serviceType": interpolate(config.seoTemplates.corporateServiceType, seoTokens),
  "url": `https://${config.contact.domain}${canonicalPath}`,
  "provider": {
    "@type": "LocalBusiness",
    "name": businessName,
    "url": `https://${config.contact.domain}`,
    "telephone": phone,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": config.contact.address.street,
      "addressLocality": province,
      "addressRegion": config.contact.address.city,
      "postalCode": config.contact.address.postalCode,
      "addressCountry": "TR"
    },
  },
  "areaServed": config.serviceAreas.map(area => ({
    "@type": "Place",
    "name": `${area.district}, ${area.city}`
  }))
};

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Kurumsal', url: '/kurumsal/' },
];

const corporateConfig = config.corporate as {
  title: string;
  description: string;
  sectors: { name: string; description: string; icon: string }[];
  advantages: { title: string; description: string; icon: string }[];
};
const sectors = corporateConfig.sectors;
const advantages = corporateConfig.advantages;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>

  <!-- ════════════════════════════════════════════
       HERO
       ════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary to-primary-dark text-white pt-8 sm:pt-10 lg:pt-12 pb-12 sm:pb-16 lg:pb-20">
    <div class="absolute inset-0 opacity-[0.06]" aria-hidden="true">
      <div class="absolute -top-24 right-0 w-[500px] h-[500px] bg-accent rounded-full blur-3xl translate-x-1/3"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-secondary rounded-full blur-3xl -translate-x-1/4 translate-y-1/4"></div>
    </div>

    <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true"
         style="background-image: radial-gradient(circle, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 32px 32px;">
    </div>

    <div class="section-container relative z-10">
      <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-white/70">
          <li><a href="/" class="hover:text-white transition-colors">Ana Sayfa</a></li>
          <li aria-hidden="true">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </li>
          <li class="text-white font-medium">Kurumsal</li>
        </ol>
      </nav>

      <div class="flex-1">
        <span class="badge bg-white/10 text-white/90 backdrop-blur-sm mb-4">Kurumsal Çözümler</span>

        <h1 class="text-hero font-bold mb-6 leading-tight">
          Kurumsal {sectorLabel} Hizmetleri
        </h1>

        <p class="text-lg sm:text-xl text-white/80 max-w-2xl mb-10 leading-relaxed">
          {corporateConfig.description}
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href={`tel:${phoneClean}`} class="btn-primary text-base sm:text-lg px-8 py-4">
            <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Teklif Alın
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp text-base sm:text-lg px-8 py-4 gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            WhatsApp ile Yazın
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       HEDEF SEKTÖRLER
       ════════════════════════════════════════════ -->
  <section class="bg-white section-padding">
    <div class="section-container">
      <div class="text-center mb-12">
        <h2 class="section-title">Hedef Sektörler</h2>
        <p class="section-subtitle mx-auto mt-4">
          Hangi sektörde olursanız olun, tekstil bakım ihtiyacınıza çözüm üretiyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {sectors.map((sector) => (
          <div class="card card-hover-lift text-center">
            <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-accent/10 flex items-center justify-center">
              {sector.icon === 'building' && (
                <svg class="w-7 h-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16"/>
                  <path d="M3 21h18"/>
                  <path d="M9 7h1M9 11h1M9 15h1M14 7h1M14 11h1M14 15h1"/>
                </svg>
              )}
              {sector.icon === 'utensils' && (
                <svg class="w-7 h-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
                  <path d="M7 2v20"/>
                  <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
                </svg>
              )}
              {sector.icon === 'briefcase' && (
                <svg class="w-7 h-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
              )}
              {sector.icon === 'store' && (
                <svg class="w-7 h-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/>
                  <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                  <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/>
                  <path d="M2 7h20"/>
                </svg>
              )}
              {sector.icon === 'dumbbell' && (
                <svg class="w-7 h-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6.5 6.5 11 11"/>
                  <path d="m21 21-1-1"/>
                  <path d="m3 3 1 1"/>
                  <path d="m18 22 4-4"/>
                  <path d="m2 6 4-4"/>
                  <path d="m3 10 7-7"/>
                  <path d="m14 21 7-7"/>
                </svg>
              )}
              {sector.icon === 'bank' && (
                <svg class="w-7 h-7 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3"/>
                </svg>
              )}
            </div>
            <h3 class="text-lg font-bold text-primary mb-2">{sector.name}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{sector.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       KURUMSAL AVANTAJLAR
       ════════════════════════════════════════════ -->
  <section class="bg-surface section-padding">
    <div class="section-container">
      <div class="text-center mb-12">
        <h2 class="section-title">Kurumsal Avantajlar</h2>
        <p class="section-subtitle mx-auto mt-4">
          İşletmenize özel ayrıcalıklar ile {sectorLabel.toLowerCase()} hizmetini kolaylaştırıyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {advantages.map((adv) => (
          <div class="card card-hover-lift">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center shrink-0">
                {adv.icon === 'tag' && (
                  <svg class="w-6 h-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/>
                    <path d="M7 7h.01"/>
                  </svg>
                )}
                {adv.icon === 'calendar' && (
                  <svg class="w-6 h-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                    <line x1="16" x2="16" y1="2" y2="6"/>
                    <line x1="8" x2="8" y1="2" y2="6"/>
                    <line x1="3" x2="21" y1="10" y2="10"/>
                  </svg>
                )}
                {adv.icon === 'document' && (
                  <svg class="w-6 h-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" x2="8" y1="13" y2="13"/>
                    <line x1="16" x2="8" y1="17" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                  </svg>
                )}
                {adv.icon === 'user' && (
                  <svg class="w-6 h-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                  </svg>
                )}
              </div>
              <div>
                <h3 class="font-bold text-primary text-lg mb-1">{adv.title}</h3>
                <p class="text-text-secondary text-sm leading-relaxed">{adv.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       NASIL ÇALIŞIR
       ════════════════════════════════════════════ -->
  <section class="bg-white section-padding">
    <div class="section-container">
      <div class="text-center mb-14">
        <h2 class="section-title">Nasıl Çalışır?</h2>
        <p class="section-subtitle mx-auto mt-4">
          3 adımda kurumsal hizmet nasıl başlıyor?
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 max-w-4xl mx-auto">
        <!-- Step 1 -->
        <div class="relative text-center group">
          <div class="flex items-center justify-center w-16 h-16 mx-auto mb-6 bg-white rounded-2xl shadow-card border border-accent/10 group-hover:shadow-elevated group-hover:border-accent/30 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
          </div>
          <span class="badge mb-3">Adım 1</span>
          <h3 class="font-bold text-primary text-lg mb-2">İletişime Geçin</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Telefon veya WhatsApp ile bize ulaşın. İşletmenizin ihtiyaçlarını dinleyelim, size özel teklif hazırlayalım.
          </p>
          <div class="hidden md:block absolute top-8 -right-6 lg:-right-8 w-12 lg:w-16" aria-hidden="true">
            <svg class="w-full text-accent/30" viewBox="0 0 60 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M0 10h50M45 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative text-center group">
          <div class="flex items-center justify-center w-16 h-16 mx-auto mb-6 bg-white rounded-2xl shadow-card border border-accent/10 group-hover:shadow-elevated group-hover:border-accent/30 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
          </div>
          <span class="badge mb-3">Adım 2</span>
          <h3 class="font-bold text-primary text-lg mb-2">Plan Oluşturun</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            İhtiyaçlarınıza göre haftalık veya aylık hizmet planı belirleyelim, anlaşmayı yapalım.
          </p>
          <div class="hidden md:block absolute top-8 -right-6 lg:-right-8 w-12 lg:w-16" aria-hidden="true">
            <svg class="w-full text-accent/30" viewBox="0 0 60 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M0 10h50M45 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="text-center group">
          <div class="flex items-center justify-center w-16 h-16 mx-auto mb-6 bg-white rounded-2xl shadow-card border border-accent/10 group-hover:shadow-elevated group-hover:border-accent/30 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
            </svg>
          </div>
          <span class="badge mb-3">Adım 3</span>
          <h3 class="font-bold text-primary text-lg mb-2">Düzenli Hizmet</h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Plana göre düzenli toplama, temizleme ve teslim. Kurumsal fatura her ay düzenli gelir.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       CTA
       ════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary to-primary-dark text-white py-16 sm:py-20">
    <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true">
      <div class="absolute top-0 left-1/4 w-72 h-72 bg-accent rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-56 h-56 bg-secondary rounded-full blur-3xl"></div>
    </div>

    <div class="section-container relative z-10 text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4">
        Kurumsal Teklifinizi Hemen Alın
      </h2>
      <p class="text-white/75 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
        İşletmenizin {sectorLabel.toLowerCase()} ihtiyaçlarını konuşalım. Toplu fiyat avantajı ve periyodik hizmet planları hakkında bilgi alın.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`tel:${phoneClean}`} class="btn-primary text-base sm:text-lg px-8 py-4 w-full sm:w-auto">
          <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Hemen Arayın
        </a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp text-base sm:text-lg px-8 py-4 gap-2 w-full sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
