---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import Contact from '../../components/Contact.astro';
import config from '../../../config/site.config.json';
import { interpolate } from '../../utils/engine';

const businessName = config.identity.businessName;
const sectorLabel = config.identity.sectorLabel;
const province = config.contact.address.province;
const phone = config.contact.phone;
const phoneClean = phone.replace(/\s/g, '');
const whatsappClean = config.contact.whatsapp.replace(/[\s+]/g, '');
const whatsappUrl = `https://wa.me/${whatsappClean}`;

const seoTokens = {
  businessName,
  sectorLabel,
  province,
  establishedYear: String(config.identity.establishedYear),
};

const title = interpolate(config.seoTemplates.aboutTitle, seoTokens);
const description = interpolate(config.seoTemplates.aboutDescription, seoTokens);
const canonicalPath = '/hakkimizda/';

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Hakkımızda', url: '/hakkimizda/' },
];

const { googleRating, reviewCount } = config.socialProof;
const serviceCount = config.services.length;
const areaCount = config.serviceAreas.length;
const neighborhoodCount = config.serviceAreas.reduce(
  (sum: number, area: { neighborhoods: unknown[] }) => sum + area.neighborhoods.length, 0
);

const storyTokens = {
  ...seoTokens,
  serviceCount: String(serviceCount),
  areaCount: String(areaCount),
  neighborhoodCount: String(neighborhoodCount),
  googleRating: String(googleRating),
  reviewCount: String(reviewCount),
};
const aboutStoryParagraphs = (config.contentTokens.aboutStoryParagraphs as string[]).map(
  (p: string) => interpolate(p, storyTokens)
);
const aboutValues = config.contentTokens.aboutValues as { title: string; description: string; icon: string }[];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} breadcrumbs={breadcrumbs}>

  <!-- ════════════════════════════════════════════
       HERO
       ════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary to-primary-dark text-white pt-8 sm:pt-10 lg:pt-12 pb-12 sm:pb-16 lg:pb-20">
    <div class="absolute inset-0 opacity-[0.06]" aria-hidden="true">
      <div class="absolute -top-24 right-0 w-[500px] h-[500px] bg-accent rounded-full blur-3xl translate-x-1/3"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-secondary rounded-full blur-3xl -translate-x-1/4 translate-y-1/4"></div>
    </div>

    <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true"
         style="background-image: radial-gradient(circle, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 32px 32px;">
    </div>

    <div class="section-container relative z-10">
      <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-white/70">
          <li><a href="/" class="hover:text-white transition-colors">Ana Sayfa</a></li>
          <li aria-hidden="true">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </li>
          <li class="text-white font-medium">Hakkımızda</li>
        </ol>
      </nav>

      <div class="flex-1">
        <span class="badge bg-white/10 text-white/90 backdrop-blur-sm mb-4">
          {config.identity.establishedYear}'den Beri
        </span>

        <h1 class="text-hero font-bold mb-6 leading-tight">Hakkımızda</h1>

        <p class="text-lg sm:text-xl text-white/80 max-w-2xl mb-10 leading-relaxed">
          {businessName} olarak {config.identity.establishedYear} yılından bu yana {province} ve çevre bölgelerde
          profesyonel {sectorLabel.toLowerCase()} hizmeti veriyoruz. Uzman kadromuzla kaliteli ve güvenilir hizmet sunmak bizim önceliğimiz.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href={`tel:${phoneClean}`} class="btn-primary text-base sm:text-lg px-8 py-4">
            <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Hemen Arayın
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp text-base sm:text-lg px-8 py-4 gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            WhatsApp ile Yazın
          </a>
        </div>
      </div>

      <div class="mt-10">
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-white/60 text-sm">
          {(config.contentTokens.serviceHighlights as string[]).map((highlight: string, i: number) => (
            <>
              {i > 0 && <span class="text-white/20" aria-hidden="true">|</span>}
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {highlight}
              </span>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       HİKAYEMİZ
       ════════════════════════════════════════════ -->
  <section class="bg-white section-padding">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="section-title">Hikayemiz</h2>
          <div class="text-text-secondary leading-relaxed space-y-4 mt-8">
            {aboutStoryParagraphs.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

        <div class="bg-surface rounded-2xl p-8">
          <div class="grid grid-cols-2 gap-6">
            <div class="text-center">
              <div class="text-3xl sm:text-4xl font-bold text-accent mb-1">{config.identity.establishedYear}</div>
              <p class="text-sm text-text-secondary">Kuruluş Yılı</p>
            </div>
            <div class="text-center">
              <div class="text-3xl sm:text-4xl font-bold text-accent mb-1">{areaCount} İlçe</div>
              <p class="text-sm text-text-secondary">Hizmet Alanı</p>
            </div>
            <div class="text-center">
              <div class="text-3xl sm:text-4xl font-bold text-accent mb-1">{serviceCount}</div>
              <p class="text-sm text-text-secondary">Hizmet Türü</p>
            </div>
            <div class="text-center">
              <div class="text-3xl sm:text-4xl font-bold text-accent mb-1">6 Gün</div>
              <p class="text-sm text-text-secondary">Haftalık Çalışma</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       DEĞERLERİMİZ
       ════════════════════════════════════════════ -->
  <section class="bg-surface section-padding">
    <div class="section-container">
      <div class="text-center mb-12">
        <h2 class="section-title">Değerlerimiz</h2>
        <p class="section-subtitle mx-auto mt-4">
          Her parçaya bu ilkelerle dokunuyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {aboutValues.map((value) => (
          <div class="card text-center">
            <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-accent/10 flex items-center justify-center">
              {value.icon === 'shield' && (
                <svg class="w-8 h-8 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              )}
              {value.icon === 'leaf' && (
                <svg class="w-8 h-8 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 8c.7 0 1.4.1 2 .3"/>
                  <path d="M5 8c-.7 0-1.4.1-2 .3"/>
                  <path d="M12 2a5 5 0 0 1 5 5c0 4-5 7-5 7S7 11 7 7a5 5 0 0 1 5-5Z"/>
                  <path d="M12 22c-4 0-8-1-8-4 0-2 2-3 4-3.5"/>
                  <path d="M12 22c4 0 8-1 8-4 0-2-2-3-4-3.5"/>
                </svg>
              )}
              {value.icon === 'star' && (
                <svg class="w-8 h-8 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              )}
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-primary mb-2">{value.title}</h3>
            <p class="text-text-secondary text-sm sm:text-base leading-relaxed">
              {value.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       CTA
       ════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary to-primary-dark text-white py-16 sm:py-20">
    <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true">
      <div class="absolute top-0 left-1/4 w-72 h-72 bg-accent rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-56 h-56 bg-secondary rounded-full blur-3xl"></div>
    </div>

    <div class="section-container relative z-10 text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4">
        Kıyafetleriniz Uzman Ellerde
      </h2>
      <p class="text-white/75 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
        {province} ve çevre bölgelerde kapınıza gelen al-götür servisimizle profesyonel tekstil bakımı bir telefon kadar yakın.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`tel:${phoneClean}`} class="btn-primary text-base sm:text-lg px-8 py-4 w-full sm:w-auto">
          <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Hemen Arayın
        </a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp text-base sm:text-lg px-8 py-4 gap-2 w-full sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          WhatsApp ile Yazın
        </a>
      </div>
    </div>
  </section>

  <FAQ />
  <Contact />
</BaseLayout>
