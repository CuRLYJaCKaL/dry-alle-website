---
import BaseLayout from '../../layouts/BaseLayout.astro';
import config from '../../../config/site.config.json';
import { getCollection } from 'astro:content';

// Tarih-kapisi: ileri tarihli (yayin tarihi gelmemis) yazilar listede gorunmez.
const posts = await getCollection('blog', ({ data }) => data.date <= new Date().toISOString().slice(0, 10));
const now = new Date();
const sortedPosts = posts
  .filter((post) => new Date(post.data.date) <= now)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const title = `Blog | ${config.identity.businessName}`;
const description = `${config.identity.businessName} blog yazıları. Kuru temizleme ipuçları, bakım önerileri ve daha fazlası.`;

function estimateReadingTime(body: string): number {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

const featuredPost = sortedPosts.length > 0 ? sortedPosts[0] : null;
const remainingPosts = sortedPosts.slice(1);

function trCapitalize(text: string): string {
  return text
    .split(' ')
    .map((w) => (w.length > 0 ? w.charAt(0).toLocaleUpperCase('tr-TR') + w.slice(1) : w))
    .join(' ');
}

function searchText(post: { data: { title: string; description: string; tags?: string[] } }): string {
  return [post.data.title, post.data.description, ...(post.data.tags ?? [])]
    .join(' ')
    .toLocaleLowerCase('tr-TR');
}

function tagKeys(post: { data: { tags?: string[] } }): string {
  return (post.data.tags ?? []).map((t) => t.toLocaleLowerCase('tr-TR')).join('|');
}

const tagCounts = new Map<string, number>();
for (const post of sortedPosts) {
  for (const tag of post.data.tags ?? []) {
    const key = tag.toLocaleLowerCase('tr-TR');
    tagCounts.set(key, (tagCounts.get(key) ?? 0) + 1);
  }
}
const topTags = [...tagCounts.entries()]
  .filter(([, count]) => count >= 2)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([key, count]) => ({ key, label: trCapitalize(key), count }));
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/blog/"
  breadcrumbs={[
    { name: 'Ana Sayfa', url: '/' },
    { name: 'Blog', url: '/blog/' }
  ]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary-dark text-white pt-8 sm:pt-10 lg:pt-12 pb-12 sm:pb-16 lg:pb-20">
    <div class="section-container">
      <nav class="mb-6 text-sm text-white/60" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li>
            <a href="/" class="hover:text-white transition-colors inline-flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1" /></svg>
              Ana Sayfa
            </a>
          </li>
          <li>
            <svg class="w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </li>
          <li class="text-white font-medium">Blog</li>
        </ol>
      </nav>

      <h1 class="text-hero font-bold mb-4">Blog</h1>
      <p class="text-lg sm:text-xl text-white/85 max-w-3xl">
        {config.identity.sectorLabel} ipuçları, bakım önerileri ve sektörel bilgiler.
        Uzman kadromuzun deneyimlerini sizinle paylaşıyoruz.
      </p>
    </div>
  </section>

  <!-- Blog Content -->
  <section class="section-padding bg-white">
    <div class="section-container">
      {sortedPosts.length === 0 ? (
        <!-- Empty State -->
        <div class="text-center py-16 max-w-lg mx-auto">
          <div class="mb-8">
            <svg class="w-32 h-32 mx-auto text-surface-alt" fill="none" viewBox="0 0 128 128">
              <rect x="16" y="24" width="96" height="80" rx="8" stroke="currentColor" stroke-width="3" fill="none" />
              <line x1="32" y1="48" x2="96" y2="48" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              <line x1="32" y1="62" x2="80" y2="62" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              <line x1="32" y1="76" x2="64" y2="76" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              <circle cx="96" cy="88" r="20" fill="currentColor" class="text-surface" stroke="currentColor" stroke-width="3" />
              <path d="M90 88h12M96 82v12" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-primary mb-3">Yazılar Hazırlanıyor</h2>
          <p class="text-text-secondary mb-8 leading-relaxed">
            Blog yazılarımız üzerinde çalışıyoruz. Çok yakında {config.identity.sectorLabel.toLowerCase()} ipuçları,
            bakım rehberleri ve daha fazlasını burada bulabileceksiniz.
          </p>
          <a href="/" class="btn-primary">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Ana Sayfaya Dön
          </a>
        </div>
      ) : (
        <div>
          <!-- Featured Post -->
          <!-- Arama + kategori filtresi -->
          <div class="mb-10">
            <label class="relative block mb-5">
              <span class="sr-only">Blog yazılarında ara</span>
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
              <input
                type="search"
                id="blog-search"
                placeholder="Yazılarda ara (örn. leke, koltuk, ipek halı...)"
                autocomplete="off"
                class="w-full min-h-[48px] rounded-xl border border-border bg-white pl-12 pr-4 py-3 text-base text-text-primary placeholder:text-text-secondary/70 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30 transition-colors"
              />
            </label>
            {topTags.length > 0 && (
              <div class="flex flex-wrap gap-2" role="group" aria-label="Kategoriye göre filtrele">
                <button
                  type="button"
                  class="blog-filter-chip min-h-[44px] rounded-full px-4 py-2 text-sm font-semibold border transition-colors bg-primary text-white border-primary"
                  data-tag=""
                  aria-pressed="true"
                >
                  Tümü <span class="opacity-70">({sortedPosts.length})</span>
                </button>
                {topTags.map((tag) => (
                  <button
                    type="button"
                    class="blog-filter-chip min-h-[44px] rounded-full px-4 py-2 text-sm font-semibold border transition-colors bg-white text-text-primary border-border hover:border-accent"
                    data-tag={tag.key}
                    aria-pressed="false"
                  >
                    {tag.label} <span class="opacity-60">({tag.count})</span>
                  </button>
                ))}
              </div>
            )}
            <p id="blog-count" class="mt-4 text-sm text-text-secondary" aria-live="polite"></p>
          </div>

          {featuredPost && (
            <a
              href={`/blog/${featuredPost.slug}/`}
              class="group block mb-12 lg:mb-16"
              data-blog-card
              data-search={searchText(featuredPost)}
              data-tags={tagKeys(featuredPost)}
            >
              <div class="relative bg-gradient-to-r from-surface to-white rounded-2xl overflow-hidden border border-border/60 hover:shadow-elevated transition-all duration-500 lg:grid lg:grid-cols-2 lg:items-stretch">
                <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b from-accent to-secondary rounded-l-2xl z-10"></div>
                {featuredPost.data.image && (
                  <img
                    src={featuredPost.data.image}
                    alt={featuredPost.data.title}
                    width="1200"
                    height="630"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                    class="w-full h-56 sm:h-72 lg:h-full object-cover lg:order-2"
                  />
                )}
                <div class="p-8 sm:p-10 lg:p-12 pl-10 sm:pl-12 lg:pl-14">
                  <div class="flex items-center gap-3 mb-4">
                    <span class="inline-flex items-center gap-1.5 bg-accent/10 text-accent px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide">
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                      Öne Çıkan
                    </span>
                  </div>

                  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-primary mb-4 group-hover:text-secondary transition-colors duration-300">
                    {featuredPost.data.title}
                  </h2>

                  <p class="text-text-secondary text-base sm:text-lg leading-relaxed mb-6 max-w-3xl">
                    {featuredPost.data.description}
                  </p>

                  <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-text-secondary">
                    {featuredPost.data.date && (
                      <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        <time>
                          {new Date(featuredPost.data.date).toLocaleDateString('tr-TR', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                          })}
                        </time>
                      </div>
                    )}
                    <div class="flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                      <span>{estimateReadingTime(featuredPost.body)} dk okuma</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-secondary font-semibold group-hover:gap-3 transition-all duration-300">
                      <span>Yazıyı Oku</span>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          )}

          <!-- Remaining Posts Grid -->
          {remainingPosts.length > 0 && (
            <div>
              <h2 class="section-title mb-8">Tüm Yazılar</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                {remainingPosts.map((post) => (
                  <a
                    href={`/blog/${post.slug}/`}
                    class="group block rounded-2xl bg-white border border-border/60 overflow-hidden hover:shadow-elevated hover:border-accent/30 transition-all duration-400"
                    data-blog-card
                    data-search={searchText(post)}
                    data-tags={tagKeys(post)}
                  >
                    <!-- Accent top border -->
                    <div class="h-1 bg-gradient-to-r from-accent to-secondary opacity-0 group-hover:opacity-100 transition-opacity duration-400"></div>

                    {post.data.image && (
                      <img
                        src={post.data.image}
                        alt={post.data.title}
                        width="1200"
                        height="630"
                        loading="lazy"
                        decoding="async"
                        class="w-full aspect-[1200/630] object-cover"
                      />
                    )}

                    <div class="p-6 sm:p-7">
                      <!-- Tags -->
                      {post.data.tags && post.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-2 mb-3">
                          {post.data.tags.slice(0, 2).map((tag: string) => (
                            <span class="bg-surface text-secondary text-xs font-medium px-2.5 py-0.5 rounded-full">
                              {tag}
                            </span>
                          ))}
                        </div>
                      )}

                      <h3 class="text-lg font-bold text-primary mb-3 group-hover:text-secondary transition-colors duration-300 line-clamp-2">
                        {post.data.title}
                      </h3>

                      <p class="text-text-secondary text-sm leading-relaxed mb-5 line-clamp-3">
                        {post.data.description}
                      </p>

                      <div class="flex items-center justify-between pt-4 border-t border-border/40">
                        <div class="flex items-center gap-4 text-xs text-text-secondary">
                          {post.data.date && (
                            <div class="flex items-center gap-1">
                              <svg class="w-3.5 h-3.5 text-accent/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                              <time>
                                {new Date(post.data.date).toLocaleDateString('tr-TR', {
                                  year: 'numeric',
                                  month: 'short',
                                  day: 'numeric'
                                })}
                              </time>
                            </div>
                          )}
                          <div class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-accent/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span>{estimateReadingTime(post.body)} dk</span>
                          </div>
                        </div>

                        <div class="flex items-center gap-1 text-secondary text-sm font-semibold group-hover:gap-2 transition-all duration-300">
                          <span>Oku</span>
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        </div>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Filtre boş sonuç durumu -->
          <div id="blog-no-results" class="hidden text-center py-16 max-w-lg mx-auto">
            <svg class="w-16 h-16 mx-auto text-surface-alt mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
            <h3 class="text-xl font-bold text-primary mb-2">Aramanızla eşleşen yazı bulunamadı</h3>
            <p class="text-text-secondary mb-6">Farklı bir anahtar kelime deneyin veya tüm yazılara göz atın.</p>
            <button type="button" id="blog-clear-filters" class="btn-primary min-h-[44px]">Filtreleri Temizle</button>
          </div>
        </div>
      )}
    </div>
  </section>

  <script>
    function initBlogFilter() {
      var search = document.getElementById('blog-search');
      if (!search) return;
      if (search.dataset.initialized) return;
      search.dataset.initialized = 'true';

      var cards = Array.prototype.slice.call(document.querySelectorAll('[data-blog-card]'));
      var chips = Array.prototype.slice.call(document.querySelectorAll('.blog-filter-chip'));
      var countEl = document.getElementById('blog-count');
      var emptyEl = document.getElementById('blog-no-results');
      var clearBtn = document.getElementById('blog-clear-filters');
      var activeTag = '';

      function applyFilters() {
        var query = search.value.trim().toLocaleLowerCase('tr-TR');
        var visible = 0;
        cards.forEach(function (card) {
          var matchesSearch = !query || (card.dataset.search || '').indexOf(query) !== -1;
          var tags = (card.dataset.tags || '').split('|');
          var matchesTag = !activeTag || tags.indexOf(activeTag) !== -1;
          var show = matchesSearch && matchesTag;
          card.classList.toggle('hidden', !show);
          if (show) visible++;
        });
        if (countEl) {
          countEl.textContent = (query || activeTag) ? visible + ' yazı gösteriliyor' : '';
        }
        if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          activeTag = chip.dataset.tag || '';
          chips.forEach(function (c) {
            var isActive = c === chip;
            c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            c.classList.toggle('bg-primary', isActive);
            c.classList.toggle('text-white', isActive);
            c.classList.toggle('border-primary', isActive);
            c.classList.toggle('bg-white', !isActive);
            c.classList.toggle('text-text-primary', !isActive);
            c.classList.toggle('border-border', !isActive);
          });
          applyFilters();
        });
      });

      search.addEventListener('input', applyFilters);

      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          search.value = '';
          activeTag = '';
          var allChip = chips.length > 0 ? chips[0] : null;
          if (allChip) allChip.click();
          else applyFilters();
        });
      }
    }

    document.addEventListener('astro:page-load', initBlogFilter);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlogFilter);
    } else {
      initBlogFilter();
    }
  </script>

  <!-- Bottom CTA -->
  {sortedPosts.length > 0 && (
    <section class="py-16 sm:py-20 bg-gradient-to-br from-primary to-primary-dark">
      <div class="section-container text-center">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
            Profesyonel Temizlik Hizmeti Alın
          </h2>
          <p class="text-white/75 text-base sm:text-lg mb-4 leading-relaxed">
            {config.identity.tagline}. Kumaş uzmanı kadromuzla tanışmak için hemen iletişime geçin.
          </p>

          <!-- Rating Badge -->
          <p class="text-white/60 text-sm mb-8 flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-yellow-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-white font-semibold">{config.socialProof.googleRating} / 5</span> puan ({config.socialProof.reviewCount} değerlendirme)
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/#iletisim" class="btn-primary">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              Hemen Arayın
            </a>
            <a
              href={`https://wa.me/${config.contact.whatsapp.replace(/[\s+]/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp"
            >
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
              WhatsApp ile Yazın
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .transition-all {
    transition-property: all;
  }
  .duration-400 {
    transition-duration: 400ms;
  }
</style>
