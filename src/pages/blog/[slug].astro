---
import BaseLayout from '../../layouts/BaseLayout.astro';
import config from '../../../config/site.config.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const title = `${post.data.title} | ${config.identity.businessName}`;
const description = post.data.description;
const canonicalPath = `/blog/${post.slug}/`;

function estimateReadingTime(body: string): number {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

const readingTime = estimateReadingTime(post.body);

// Get other posts for "Diğer Yazılar" section
const allPosts = await getCollection('blog');
const otherPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const coverImage = post.data.image;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": `https://${config.contact.domain}${coverImage ?? '/images/og-default.png'}`,
  "datePublished": post.data.date,
  "dateModified": post.data.date,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://${config.contact.domain}${canonicalPath}`
  },
  "author": {
    "@type": "Organization",
    "name": config.identity.businessName,
    "url": `https://${config.contact.domain}`
  },
  "publisher": {
    "@type": "Organization",
    "name": config.identity.businessName,
    "logo": {
      "@type": "ImageObject",
      "url": `https://${config.contact.domain}/images/logo.png`
    }
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  ogImage={coverImage}
  ogType="article"
  articleMeta={{ publishedTime: post.data.date, modifiedTime: post.data.date, author: config.identity.businessName }}
  breadcrumbs={[
    { name: 'Ana Sayfa', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: post.data.title, url: `/blog/${post.slug}/` }
  ]}
>
  <!-- Mini Hero -->
  <section class="bg-gradient-to-br from-primary to-primary-dark text-white pt-8 sm:pt-10 lg:pt-12 pb-12 sm:pb-16 lg:pb-20">
    <div class="section-container max-w-4xl">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-sm text-white/60" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li>
            <a href="/" class="hover:text-white transition-colors inline-flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1" /></svg>
              Ana Sayfa
            </a>
          </li>
          <li>
            <svg class="w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </li>
          <li>
            <a href="/blog/" class="hover:text-white transition-colors">Blog</a>
          </li>
          <li>
            <svg class="w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </li>
          <li class="text-white/90 font-medium truncate max-w-[200px] sm:max-w-xs">{post.data.title}</li>
        </ol>
      </nav>

      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-5">
          {post.data.tags.map((tag: string) => (
            <span class="bg-white/10 text-accent-light text-xs font-semibold px-3 py-1 rounded-full border border-white/10">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Title -->
      <h1 class="text-hero font-bold mb-6 leading-tight">{post.data.title}</h1>

      <!-- Meta Info Bar -->
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/70">
        <!-- Author -->
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <span>{config.identity.businessName}</span>
        </div>

        <!-- Divider -->
        <span class="hidden sm:block w-1 h-1 rounded-full bg-white/30"></span>

        <!-- Date -->
        {post.data.date && (
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-accent/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            <time>
              {new Date(post.data.date).toLocaleDateString('tr-TR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </div>
        )}

        <!-- Divider -->
        <span class="hidden sm:block w-1 h-1 rounded-full bg-white/30"></span>

        <!-- Reading Time -->
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-accent/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span>{readingTime} dakika okuma</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <article class="relative">
    <!-- Subtle top overlap effect -->
    <div class="bg-gradient-to-b from-primary-dark to-transparent h-8 -mt-0"></div>

    <div class="section-container max-w-4xl -mt-8">
      <!-- Content Card -->
      <div class="bg-white rounded-2xl shadow-elevated p-6 sm:p-10 lg:p-14 mb-12">
        <!-- Cover Image -->
        {coverImage && (
          <img
            src={coverImage}
            alt={post.data.title}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="w-full rounded-xl shadow-card mb-8 aspect-[1200/630] object-cover"
          />
        )}

        <!-- Article Description -->
        {post.data.description && (
          <div class="mb-8 pb-8 border-b border-border/40">
            <p class="text-text-secondary text-lg sm:text-xl leading-relaxed italic">
              {post.data.description}
            </p>
          </div>
        )}

        <!-- Prose Content -->
        <div class="prose prose-lg max-w-none
                    prose-headings:text-primary prose-headings:font-bold prose-headings:mt-10 prose-headings:mb-4
                    prose-h2:text-2xl prose-h2:border-b prose-h2:border-border/30 prose-h2:pb-3
                    prose-h3:text-xl
                    prose-a:text-accent prose-a:font-semibold prose-a:no-underline hover:prose-a:underline hover:prose-a:text-secondary
                    prose-p:text-text-primary prose-p:leading-relaxed prose-p:mb-5
                    prose-li:text-text-primary prose-li:leading-relaxed
                    prose-strong:text-primary prose-strong:font-semibold
                    prose-blockquote:border-l-accent prose-blockquote:bg-surface/50 prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-blockquote:px-4
                    prose-hr:border-border/40 prose-hr:my-10
                    prose-img:rounded-xl prose-img:shadow-card">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- CTA Section -->
  <section class="pb-16 sm:pb-20">
    <div class="section-container max-w-4xl">
      <div class="bg-gradient-to-br from-primary to-primary-dark rounded-2xl p-8 sm:p-10 lg:p-12 text-center relative overflow-hidden">
        <!-- Decorative elements -->
        <div class="absolute top-0 right-0 w-40 h-40 bg-accent/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-secondary/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>

        <div class="relative z-10">
          <div class="w-14 h-14 mx-auto mb-5 rounded-full bg-accent/15 flex items-center justify-center">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">
            Profesyonel {config.identity.sectorLabel} Hizmeti
          </h2>
          <p class="text-white/75 text-base sm:text-lg mb-4 max-w-xl mx-auto leading-relaxed">
            {config.identity.tagline}. Ücretsiz al-götür hizmetimizle kıyafetlerinize özenle bakım sağlıyoruz.
          </p>

          <!-- Rating Badge -->
          <p class="text-white/60 text-sm mb-8 flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-yellow-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-white font-semibold">{config.socialProof.googleRating} / 5</span> puan ({config.socialProof.reviewCount} değerlendirme)
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={`tel:${config.contact.phone.replace(/\s/g, '')}`} class="btn-primary">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              {config.contact.phoneDisplay}
            </a>
            <a
              href={`https://wa.me/${config.contact.whatsapp.replace(/[\s+]/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp"
            >
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
              WhatsApp ile Yazın
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Diğer Yazılar -->
  {otherPosts.length > 0 && (
    <section class="section-padding bg-surface border-t border-border/30">
      <div class="section-container">
        <div class="text-center mb-10">
          <h2 class="section-title">Diğer Yazılar</h2>
          <p class="section-subtitle mx-auto">
            Blog'umuzdaki diğer yazılarımıza da göz atın.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {otherPosts.map((otherPost) => (
            <a
              href={`/blog/${otherPost.slug}/`}
              class="group block rounded-2xl bg-white border border-border/60 overflow-hidden hover:shadow-elevated hover:border-accent/30 transition-all duration-400"
            >
              <div class="h-1 bg-gradient-to-r from-accent to-secondary opacity-0 group-hover:opacity-100 transition-opacity duration-400"></div>

              {otherPost.data.image && (
                <img
                  src={otherPost.data.image}
                  alt={otherPost.data.title}
                  width="1200"
                  height="630"
                  loading="lazy"
                  decoding="async"
                  class="w-full aspect-[1200/630] object-cover"
                />
              )}

              <div class="p-6">
                {otherPost.data.tags && otherPost.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mb-3">
                    {otherPost.data.tags.slice(0, 2).map((tag: string) => (
                      <span class="bg-surface text-secondary text-xs font-medium px-2.5 py-0.5 rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                <h3 class="text-lg font-bold text-primary mb-3 group-hover:text-secondary transition-colors duration-300 line-clamp-2">
                  {otherPost.data.title}
                </h3>

                <p class="text-text-secondary text-sm leading-relaxed mb-5 line-clamp-3">
                  {otherPost.data.description}
                </p>

                <div class="flex items-center justify-between pt-4 border-t border-border/40">
                  <div class="flex items-center gap-1 text-xs text-text-secondary">
                    <svg class="w-3.5 h-3.5 text-accent/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    <time>
                      {new Date(otherPost.data.date).toLocaleDateString('tr-TR', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </time>
                  </div>

                  <div class="flex items-center gap-1 text-secondary text-sm font-semibold group-hover:gap-2 transition-all duration-300">
                    <span>Oku</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>

        {allPosts.length > 4 && (
          <div class="text-center mt-10">
            <a href="/blog/" class="btn-secondary">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
              Tüm Yazıları Gör
            </a>
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .duration-400 {
    transition-duration: 400ms;
  }
</style>
