---
import config from '../../config/site.config.json';

const { phone, phoneDisplay, email, whatsapp, address, geo } = config.contact;
const { businessName } = config.identity;

const phoneClean = phone.replace(/\s/g, '');
const whatsappClean = whatsapp.replace(/[\s+]/g, '');
const whatsappUrl = `https://wa.me/${whatsappClean}`;
const fullAddress = `${address.street}, ${address.province}, ${address.city}`;
---

<section id="iletisim" class="bg-primary text-white">
  <div class="section-container section-padding">
    <div class="text-center mb-12">
      <h2 class="section-title text-white">Bize Ulaşın</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16">
      <!-- Contact Info -->
      <div class="space-y-6">
        <!-- Phone -->
        <div class="flex items-start gap-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <div>
            <p class="font-semibold text-white/90 text-sm mb-1">Telefon</p>
            <a href={`tel:${phoneClean}`} class="text-white hover:text-accent transition-colors duration-200 text-lg font-medium min-h-[44px] inline-flex items-center" aria-label={`Bizi arayın: ${phoneDisplay || phone}`}>
              {phoneDisplay || phone}
            </a>
          </div>
        </div>

        <!-- Email -->
        <div class="flex items-start gap-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <div>
            <p class="font-semibold text-white/90 text-sm mb-1">E-posta</p>
            <a href={`mailto:${email}`} class="text-white hover:text-accent transition-colors duration-200 text-lg font-medium min-h-[44px] inline-flex items-center" aria-label={`E-posta gönderin: ${email}`}>
              {email}
            </a>
          </div>
        </div>

        <!-- Address -->
        <div class="flex items-start gap-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <div>
            <p class="font-semibold text-white/90 text-sm mb-1">Adres</p>
            <p class="text-white/80 text-base leading-relaxed">
              {fullAddress}
            </p>
          </div>
        </div>

        <!-- Working Hours -->
        <div class="flex items-start gap-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <div>
            <p class="font-semibold text-white/90 text-sm mb-1">Çalışma Saatleri</p>
            <p class="text-white/80 text-base">
              {config.openingHours.displayText}
            </p>
          </div>
        </div>
      </div>

      <!-- CTA Area -->
      <div class="space-y-4">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp w-full justify-center text-lg py-4 border-2 border-white/80 shadow-lg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          WhatsApp ile Yazın
        </a>
        <p class="text-white/70 text-sm text-center">
          Fotoğraf gönderin, anında fiyat ve süre bilgisi alın
        </p>

        <a
          href={`tel:${phoneClean}`}
          class="inline-flex items-center justify-center gap-3 w-full bg-white text-primary font-semibold py-4 px-6 rounded-xl text-lg hover:bg-white/90 transition-colors duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Bizi Arayın: {phoneDisplay || phone}
        </a>

        <!-- Google Maps Link -->
        <a
          href={config.contact.socialLinks.googleMaps}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-xl overflow-hidden mt-4 shadow-elevated group"
        >
          <div class="relative w-full h-[200px] rounded-xl bg-surface flex items-center justify-center group-hover:bg-accent/5 transition-colors duration-200">
            <div class="text-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-accent mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span class="text-sm font-medium text-primary">Google Haritalar'da Aç</span>
              <span class="block text-xs text-text-secondary mt-0.5">{address.province}, {address.city}</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
