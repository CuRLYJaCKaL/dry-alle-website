---
import config from '../../config/site.config.json';

const neighborhoodCount = config.serviceAreas.reduce(
  (sum: number, area: { neighborhoods: unknown[] }) => sum + area.neighborhoods.length, 0
);

const { businessName } = config.identity;
const brandName = (config.identity as Record<string, unknown>).brandName as string || businessName;
const { phone, phoneDisplay, email, address, whatsapp } = config.contact;

const phoneClean = phone.replace(/\s/g, '');
const whatsappClean = whatsapp.replace(/[\s+]/g, '');
const whatsappUrl = `https://wa.me/${whatsappClean}`;
const fullAddress = `${address.street}, ${address.province}, ${address.city}`;

const quickLinks = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Hizmetler', href: '/#hizmetler' },
  { label: 'Hakkımızda', href: '/hakkimizda/' },
  { label: 'Kurumsal', href: '/kurumsal/' },
  { label: 'Online Sipariş', href: '/siparis/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'SSS', href: '/#sss' },
  { label: 'İletişim', href: '/#iletisim' },
];

const serviceAreas = config.serviceAreas.flatMap(area =>
  area.neighborhoods.slice(0, 2).map(nh => ({
    label: nh.name,
    href: `/bolge/${area.districtSlug}/${nh.slug}/`
  }))
);
---

<footer class="bg-primary-dark text-white">
  <div class="section-container py-10 lg:py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-6">

      <!-- Col 1: Logo & Description -->
      <div class="sm:col-span-2 lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-3 mb-3">
          <img
            src="/images/logo.webp"
            alt={`${businessName} Logo`}
            class="h-14 w-auto"
            width="56"
            height="56"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-col items-center">
            <span class="font-bold text-lg text-white leading-tight">
              {brandName}
            </span>
            <span class="text-white/70 text-xs font-medium leading-tight">
              Profesyonel Tekstil Bakımı
            </span>
          </div>
        </a>
        <p class="text-white/60 text-sm leading-relaxed max-w-xs">
          {config.identity.description}
        </p>
      </div>

      <!-- Col 2: Sayfalar -->
      <div class="lg:col-span-2">
        <h3 class="font-semibold text-sm uppercase tracking-wider mb-3 text-white/90">Sayfalar</h3>
        <nav class="flex flex-col gap-0" aria-label="Alt menü navigasyonu">
          {quickLinks.map((link) => (
            <a
              href={link.href}
              class="text-white/60 hover:text-white transition-colors duration-200 text-sm py-2 min-h-[44px] inline-flex items-center"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 3: Hizmet Bölgelerimiz -->
      <div class="lg:col-span-3">
        <h3 class="font-semibold text-sm uppercase tracking-wider mb-3 text-white/90">Hizmet Bölgelerimiz</h3>
        <nav class="grid grid-cols-2 gap-x-4 gap-y-0" aria-label="Hizmet bölgeleri">
          {serviceAreas.map((area) => (
            <a
              href={area.href}
              class="text-white/60 hover:text-white transition-colors duration-200 text-sm py-2 min-h-[44px] inline-flex items-center"
            >
              {area.label}
            </a>
          ))}
        </nav>
        <p class="text-white/60 text-xs mt-3">
          {config.serviceAreas.map((a: { district: string }) => a.district).join(', ')}'da {neighborhoodCount} mahallede al-götür hizmeti
        </p>
      </div>

      <!-- Col 4: İletişim -->
      <div class="lg:col-span-3">
        <h3 class="font-semibold text-sm uppercase tracking-wider mb-3 text-white/90">İletişim</h3>
        <div class="space-y-2.5">
          <a href={`tel:${phoneClean}`} class="flex items-center gap-2.5 text-white/60 hover:text-white transition-colors duration-200 text-sm py-1" aria-label={`Bizi arayın: ${phoneDisplay || phone}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent/70 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {phoneDisplay || phone}
          </a>
          <a href={`mailto:${email}`} class="flex items-center gap-2.5 text-white/60 hover:text-white transition-colors duration-200 text-sm py-1" aria-label={`E-posta gönderin: ${email}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent/70 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            {email}
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 text-white/60 hover:text-white transition-colors duration-200 text-sm py-1" aria-label="WhatsApp ile yazın">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent/70 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            WhatsApp ile Yazın
          </a>
          <div class="flex items-start gap-2.5 text-white/60 text-sm py-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent/70 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{fullAddress}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-5 mt-8 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-white/70 text-xs">
        &copy; {new Date().getFullYear()} {businessName}. Tüm hakları saklıdır.
      </p>
      <p class="text-white/60 text-xs">
        Sarıyer, İstanbul
      </p>
    </div>
  </div>
</footer>
