---
import config from '../../config/site.config.json';

const { testimonials, googleRating, reviewCount } = config.socialProof;
---

<section id="yorumlar" class="bg-white">
  <div class="section-container section-padding">
    <div class="text-center mb-12">
      <h2 class="section-title">Müşterilerimiz Ne Diyor?</h2>
      <p class="section-subtitle mx-auto">
        Google'da {googleRating} puan — {reviewCount} müşterimizin deneyimlerinden.
      </p>
    </div>

    <!-- Google Rating Badge -->
    <div class="flex items-center justify-center gap-3 bg-white rounded-full px-5 py-2.5 shadow-card mb-10 mx-auto w-fit">
      <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
      </svg>
      <span class="text-primary font-bold text-lg border-l border-gray-300 pl-3">{googleRating}</span>
      <div class="flex items-center gap-0.5" role="img" aria-label={`${googleRating} yıldız`}>
        {[1,2,3,4,5].map(() => (
          <svg class="w-4 h-4 text-yellow-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        ))}
      </div>
      <span class="text-text-secondary text-sm border-l border-gray-300 pl-3">{reviewCount} yorum</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {testimonials.map((testimonial) => (
        <div class="relative bg-white rounded-xl shadow-card border border-transparent hover:shadow-elevated hover:border-accent/20 transition-all duration-300 p-6 overflow-hidden">
          <div class="relative z-10">
            {/* Google badge */}
            <div class="inline-flex items-center gap-1.5 bg-surface rounded-full px-3 py-1 mb-4 text-xs font-semibold text-text-secondary">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
              Google Yorumu
            </div>

            {/* SVG Stars */}
            <div class="flex items-center gap-0.5 mb-4" role="img" aria-label={`${testimonial.rating} yıldız`}>
              {[1,2,3,4,5].map((star) => (
                <svg class={`w-4 h-4 ${star <= testimonial.rating ? 'text-yellow-400' : 'text-gray-200'}`} viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <p class="text-text-secondary text-sm sm:text-base leading-relaxed mb-5">
              &ldquo;{testimonial.comment}&rdquo;
            </p>

            {/* Author with avatar initial */}
            <div class="flex items-center gap-3 pt-4 border-t border-border/60">
              <div class="w-9 h-9 rounded-full bg-gradient-to-br from-accent to-secondary flex items-center justify-center shrink-0">
                <span class="text-white text-sm font-bold">{testimonial.name.charAt(0)}</span>
              </div>
              <div>
                <p class="font-bold text-primary text-sm">{testimonial.name}</p>
                <p class="text-text-secondary text-xs">Google Yorumu</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-10">
      <a href="/#iletisim" class="btn-secondary text-sm">
        Hemen Randevu Alın
      </a>
    </div>
  </div>
</section>
