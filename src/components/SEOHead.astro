---
import config from '../../config/site.config.json';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  ogImage?: string;
  breadcrumbs?: { name: string; url: string }[];
  ogType?: string;
  articleMeta?: { publishedTime?: string; modifiedTime?: string; author?: string };
}

const { title, description, canonicalUrl, jsonLd, ogImage, breadcrumbs, ogType = 'website', articleMeta } = Astro.props;
const siteName = config.identity.businessName;
const defaultOgImage = ogImage || '/images/og-default.png';
const absoluteOgImage = defaultOgImage.startsWith('http') ? defaultOgImage : `https://${config.contact.domain}${defaultOgImage}`;

// ─────────────────────────────────────────────────────────────
// Engine-level connected @graph — her sayfada otomatik uygulanir.
// Tek kanonik isletme varligi (#business), Organization, WebSite,
// WebPage, logo ImageObject; sayfaya ozel node'lar (Service, FAQPage,
// BlogPosting, OfferCatalog) jsonLd prop'undan grafige eklenir.
// ─────────────────────────────────────────────────────────────
const domain = `https://${config.contact.domain}`;
const socialLinks = Object.values(config.contact.socialLinks || {}).filter(Boolean) as string[];
const orgId = `${domain}/#organization`;
const websiteId = `${domain}/#website`;
const businessId = `${domain}/#business`;
const logoId = `${domain}/#logo`;
const webpageId = `${canonicalUrl}#webpage`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;

const logoImage = {
  "@type": "ImageObject",
  "@id": logoId,
  "url": `${domain}/images/logo.png`,
  "width": 512,
  "height": 512,
  "caption": config.identity.businessName,
};

const organization = {
  "@type": "Organization",
  "@id": orgId,
  "name": config.identity.businessName,
  "url": domain,
  "logo": { "@id": logoId },
  "image": { "@id": logoId },
  "telephone": config.contact.phone,
  "email": config.contact.email,
  ...(socialLinks.length > 0 ? { "sameAs": socialLinks } : {}),
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": config.contact.phone,
    "contactType": "customer service",
    "areaServed": "TR",
    "availableLanguage": ["Turkish"],
  },
};

const website = {
  "@type": "WebSite",
  "@id": websiteId,
  "url": domain,
  "name": config.identity.businessName,
  "publisher": { "@id": orgId },
  "inLanguage": "tr-TR",
};

const business = {
  "@type": (config.identity as Record<string, unknown>).schemaType as string || "LocalBusiness",
  "@id": businessId,
  "name": config.identity.businessName,
  "description": config.identity.description,
  "url": domain,
  "telephone": config.contact.phone,
  "email": config.contact.email,
  "image": { "@id": logoId },
  "logo": { "@id": logoId },
  "parentOrganization": { "@id": orgId },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": config.contact.address.street,
    "addressLocality": config.contact.address.province,
    "addressRegion": config.contact.address.city,
    "postalCode": config.contact.address.postalCode,
    "addressCountry": "TR",
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": config.contact.geo.latitude,
    "longitude": config.contact.geo.longitude,
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": config.openingHours.days,
      "opens": config.openingHours.opens,
      "closes": config.openingHours.closes,
    },
  ],
  "areaServed": config.serviceAreas.map((area) => ({
    "@type": "City",
    "name": `${area.district}, ${area.city}`,
  })),
  ...(socialLinks.length > 0 ? { "sameAs": socialLinks } : {}),
  "foundingDate": String(config.identity.establishedYear),
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `${config.identity.sectorLabel} Hizmetleri`,
    "itemListElement": config.services.map((service) => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": service.name,
        "description": service.description,
      },
    })),
  },
};

const webpage: Record<string, unknown> = {
  "@type": "WebPage",
  "@id": webpageId,
  "url": canonicalUrl,
  "name": title,
  "description": description,
  "isPartOf": { "@id": websiteId },
  "about": { "@id": businessId },
  "primaryImageOfPage": absoluteOgImage,
  "inLanguage": "tr-TR",
  ...(breadcrumbs?.length ? { "breadcrumb": { "@id": breadcrumbId } } : {}),
  ...(articleMeta?.publishedTime ? { "datePublished": articleMeta.publishedTime } : {}),
  ...(articleMeta?.modifiedTime ? { "dateModified": articleMeta.modifiedTime } : {}),
};

const breadcrumbNode = breadcrumbs?.length
  ? {
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      "itemListElement": breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": crumb.name,
        "item": crumb.url.startsWith('http') ? crumb.url : `${domain}${crumb.url}`,
      })),
    }
  : null;

// Sayfaya ozel ek node'lar — isletme-tipi dublikasyonu grafikten dusurulur (tek kanonik #business).
const businessTypes = new Set(['LocalBusiness', 'DryCleaningOrLaundry', 'Organization']);
const rawExtra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const extraNodes = rawExtra
  .filter((n): n is Record<string, unknown> => Boolean(n) && !businessTypes.has(n['@type'] as string))
  .map((n) => {
    const clone: Record<string, unknown> = { ...n };
    delete clone['@context'];
    return clone;
  });

const graphJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    website,
    business,
    logoImage,
    webpage,
    ...(breadcrumbNode ? [breadcrumbNode] : []),
    ...extraNodes,
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content={config.brand.primaryColor} />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Font preload (critical body + heading fonts — others load on-demand via @font-face) -->
<link rel="preload" href="/fonts/roboto-latin-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/roboto-latin-ext-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/roboto-latin-700.woff2" as="font" type="font/woff2" crossorigin />

<!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="tr_TR" />
{articleMeta?.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
{articleMeta?.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
{articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />

<!-- Robots -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

<!-- JSON-LD Structured Data — connected @graph (engine-level, tum sayfalarda) -->
<script type="application/ld+json" set:html={JSON.stringify(graphJsonLd)} />
