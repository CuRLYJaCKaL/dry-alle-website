---
import config from '../../config/site.config.json';

const { businessName, tagline } = config.identity;
const { whatsapp, phoneDisplay, phone } = config.contact;
const { primaryCTA, secondaryCTA } = config.conversionTokens;
const { googleRating, reviewCount } = config.socialProof;

const whatsappClean = whatsapp.replace(/[\s+]/g, '');
const whatsappUrl = `https://wa.me/${whatsappClean}`;
const phoneClean = phone.replace(/\s/g, '');
---

<section id="hero" class="relative overflow-hidden bg-primary-dark py-10 sm:py-20 lg:py-24">
  <!-- Background image -->
  <img
    src="/images/hero-bg.webp"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <!-- Dark overlay for text readability -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary/85 to-primary-dark/80" aria-hidden="true"></div>
  <!-- Subtle decorative background pattern -->
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute top-0 right-0 w-96 h-96 bg-accent/5 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-secondary/5 rounded-full blur-3xl -translate-x-1/3 translate-y-1/3"></div>
  </div>

  <div class="section-container relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      <!-- H1: Brand name -->
      <h1 class="text-hero font-heading font-bold text-white mb-3 sm:mb-5">
        {businessName}
      </h1>

      <!-- Tagline -->
      <p class="text-accent font-semibold text-lg sm:text-xl mb-2 sm:mb-4 tracking-wide">
        {tagline}
      </p>

      <!-- SEO Description -->
      <p class="text-base sm:text-lg text-white/80 mb-5 sm:mb-8 max-w-2xl mx-auto leading-relaxed">
        {config.identity.heroDescription}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 mb-6">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp w-full sm:w-auto text-base px-7 py-3.5 gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          {secondaryCTA}
        </a>
        <a href={`tel:${phoneClean}`} class="btn-primary w-full sm:w-auto text-base px-7 py-3.5">
          <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {config.conversionTokens.ctaPhone}
        </a>
      </div>

      <!-- Service highlights -->
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-white/60 text-sm">
        {config.contentTokens.serviceHighlights.map((highlight: string, idx: number) => (
          <>
            {idx > 0 && <span class="hidden sm:inline text-white/20" aria-hidden="true">|</span>}
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              {highlight}
            </span>
          </>
        ))}
        <span class="hidden sm:inline text-white/20" aria-hidden="true">|</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-yellow-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <span class="text-white font-semibold">{googleRating}</span>
          <span>({reviewCount} Google Yorumu)</span>
        </span>
      </div>
    </div>
  </div>
</section>
