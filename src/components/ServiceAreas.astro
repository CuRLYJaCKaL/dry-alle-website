---
import config from '../../config/site.config.json';

const areas = config.serviceAreas;
const phone = config.contact.phone;
const phoneDisplay = config.contact.phoneDisplay;
const phoneClean = phone.replace(/\s/g, '');
---

<section id="bolgeler" class="bg-surface">
  <div class="section-container section-padding">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="section-title">Hizmet Bölgelerimiz</h2>
      <p class="section-subtitle mx-auto">
        {areas.map((a: { district: string }) => a.district).join(', ')}'da {areas.reduce((sum: number, a: { neighborhoods: unknown[] }) => sum + a.neighborhoods.length, 0)} mahallede kapınıza geliyoruz.
      </p>
    </div>

    <!-- All Areas -->
    <div class="space-y-10">
      {areas.map((area) => (
        <div>
          <!-- District Header -->
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
              <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-primary">{area.district}</h3>
            <div class="flex-1 h-px bg-border"></div>
          </div>

          <!-- Neighborhood Cards Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            {area.neighborhoods.map((neighborhood) => (
              <a
                href={`/bolge/${area.districtSlug}/${neighborhood.slug}/`}
                class="group flex items-center gap-3 bg-white rounded-xl px-4 py-3.5 border border-border/60 hover:border-accent/30 hover:shadow-card transition-all duration-200"
              >
                <div class="w-9 h-9 shrink-0 rounded-lg bg-accent/8 flex items-center justify-center group-hover:bg-accent/15 transition-colors">
                  <svg class="w-4 h-4 text-accent/70 group-hover:text-accent transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </div>
                <span class="flex-1 min-w-0 text-sm font-semibold text-primary truncate">{neighborhood.name}</span>
                <svg class="w-4 h-4 text-border group-hover:text-accent shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-14 text-center">
      <p class="text-text-secondary mb-4">
        Bölgeniz listede yok mu? Bizi arayın — hizmet alanımızı sürekli genişletiyoruz.
      </p>
      <a
        href={`tel:${phoneClean}`}
        class="btn-primary gap-2"
        aria-label={`Bizi arayın: ${phoneDisplay || phone}`}
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        {phoneDisplay || phone}
      </a>
    </div>
  </div>
</section>
