---
import config from '../../config/site.config.json';
import { interpolate } from '../utils/engine';

const neighborhoodCount = config.serviceAreas.reduce(
  (sum: number, area: { neighborhoods: unknown[] }) => sum + area.neighborhoods.length, 0
);
const faqTokens = { neighborhoodCount: String(neighborhoodCount) };

const faqs = (config.faq as { question: string; answer: string }[]).map(item => ({
  question: item.question,
  answer: interpolate(item.answer, faqTokens),
}));

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};
---

<section id="sss" class="bg-surface">
  <div class="section-container section-padding">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="section-title">Sıkça Sorulan Sorular</h2>
      <p class="section-subtitle mx-auto">
        Kuru temizleme süreciyle ilgili en çok sorulan sorular ve yanıtları.
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="max-w-3xl mx-auto space-y-3">
      {faqs.map((item) => (
        <details class="group bg-white rounded-xl border border-border/60 overflow-hidden transition-all duration-300 open:shadow-card open:border-accent/30">
          <summary class="flex items-center justify-between font-semibold text-primary cursor-pointer px-6 py-5 list-none [&::-webkit-details-marker]:hidden border-l-[3px] border-transparent group-open:border-accent transition-colors duration-300 group-open:bg-surface/40">
            <span class="pr-4 text-sm sm:text-base">{item.question}</span>
            <svg
              class="w-5 h-5 text-text-secondary/50 shrink-0 transition-[transform,color] duration-300 group-open:rotate-180 group-open:text-primary"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="text-text-secondary text-sm sm:text-base px-6 pb-5 pt-2 leading-relaxed border-l-[3px] border-accent">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- FAQPage JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
