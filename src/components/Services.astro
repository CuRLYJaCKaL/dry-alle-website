---
import config from '../../config/site.config.json';

const services = config.services;
const businessName = config.identity.businessName;
---

<section id="hizmetler" class="bg-white">
  <div class="section-container section-padding">
    <div class="text-center mb-12">
      <h2 class="section-title">Hizmetlerimiz</h2>
      <p class="section-subtitle mx-auto">
        {config.contentTokens.servicesSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map((service) => (
        <a
          href={`/hizmetler/${service.slug}/`}
          class="group block rounded-xl overflow-hidden bg-white border border-border/60 shadow-card hover:shadow-elevated hover:border-accent/30 transition-[box-shadow,border-color] duration-300"
        >
          {/* Gradient Header with Icon & Service Name */}
          <div class="relative h-44 sm:h-48 bg-gradient-to-br from-primary via-primary-dark to-secondary/90 flex flex-col items-center justify-center p-6 text-center overflow-hidden">
            {/* Decorative circles */}
            <div class="absolute -top-6 -right-6 w-24 h-24 rounded-full bg-accent/10" aria-hidden="true"></div>
            <div class="absolute -bottom-4 -left-4 w-16 h-16 rounded-full bg-white/5" aria-hidden="true"></div>

            {/* Large decorative service icon */}
            {service.icon === 'organic' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22c5.523-7.242 3.678-13.636 0-17C8.322 8.364 6.477 14.758 12 22z" />
                <path d="M12 22V9" />
                <path d="M9 14c2-1 4-1 6 0" />
              </svg>
            )}
            {service.icon === 'shirt' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.5 2H9.5L7 5v3l3 2v12h4V10l3-2V5l-2.5-3z" />
              </svg>
            )}
            {service.icon === 'iron' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 17h18l-3-8H9L3 17z" />
                <path d="M9 9V5h6v4" />
                <path d="M6 17v2h12v-2" />
              </svg>
            )}
            {service.icon === 'carpet' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="1" />
                <path d="M3 8h18M3 16h18M8 4v16M16 4v16" />
                <circle cx="12" cy="12" r="2" />
              </svg>
            )}
            {service.icon === 'curtain' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 3h16M6 3v18M18 3v18M6 3c0 5 3 5 3 9s-3 4-3 9M18 3c0 5-3 5-3 9s3 4 3 9M9 21h6"/>
              </svg>
            )}
            {service.icon === 'bag' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9h12l1.2 11a1 1 0 0 1-1 1.1H5.8a1 1 0 0 1-1-1.1L6 9zM9 9V7a3 3 0 0 1 6 0v2"/>
              </svg>
            )}
            {service.icon === 'palette' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21a9 9 0 1 1 9-9c0 2.5-2 3.5-3.5 3.5H15a2 2 0 0 0-1.4 3.4c.3.3.4.7.4 1.1a2 2 0 0 1-2 2zM7.5 10.5h.01M12 7.5h.01M16.5 10.5h.01"/>
              </svg>
            )}
            {service.icon === 'shoe' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 17.5h18c-.3-2.7-3.6-4.5-7.5-4.5l-1.8-5.5-4.7 2v8zM3 17.5V20h18v-2.5M9.5 9.7l1.5 1.3M11.5 8.9l1.5 1.3"/>
              </svg>
            )}
            {service.icon === 'suit' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2l4 4-2 16h8l-2-16 4-4" />
                <path d="M10 6l2 4 2-4" />
                <circle cx="12" cy="14" r="0.5" fill="currentColor" />
                <circle cx="12" cy="17" r="0.5" fill="currentColor" />
              </svg>
            )}
            {service.icon === 'dress' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 2h4l1 6-3 2-3-2 1-6z" />
                <path d="M8 10c-2 4-3 8-3 12h14c0-4-1-8-3-12" />
                <path d="M8 16h8" />
              </svg>
            )}
            {service.icon === 'leather' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 2v4L4 8v10l4 2h8l4-2V8l-4-2V2" />
                <path d="M8 6h8" />
                <path d="M12 6v16" />
              </svg>
            )}
            {service.icon === 'sofa' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 11V8a2 2 0 012-2h12a2 2 0 012 2v3" />
                <path d="M2 11h20v6a2 2 0 01-2 2H4a2 2 0 01-2-2v-6z" />
                <path d="M5 19v2M19 19v2" />
                <path d="M2 14h20" />
              </svg>
            )}
            {service.icon === 'textile' && (
              <svg class="absolute right-3 top-1/2 -translate-y-1/2 text-white opacity-[0.07] w-28 h-28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 2h16v5c0 3-4 4-8 4S4 10 4 7V2z" />
                <path d="M4 7c0 5 0 15 0 15h16V7" />
                <path d="M12 7v15" />
              </svg>
            )}

            {/* Service Name */}
            <h3 class="relative z-10 text-white font-bold text-lg sm:text-xl uppercase tracking-wide leading-snug max-w-[85%]">
              {service.name}
            </h3>
            <span class="relative z-10 text-accent-light text-xs mt-2 font-medium tracking-wider">
              {businessName}
            </span>
          </div>

          {/* Content */}
          <div class="p-5 sm:p-6">
            <p class="text-text-secondary text-sm leading-relaxed mb-4 line-clamp-3">
              {service.description}
            </p>
            <span class="inline-flex items-center gap-1.5 text-secondary font-semibold text-sm group-hover:gap-2.5 transition-[gap] duration-300">
              Detaylı Bilgi
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
