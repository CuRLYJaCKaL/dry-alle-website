---
import config from '../../config/site.config.json';

const corporateConfig = config.corporate as { title: string; description: string; bulletPoints: string[]; sectors: { name: string; icon: string }[] } | undefined;
const sectors = corporateConfig?.sectors?.map(s => ({ name: s.name.split(' & ')[0].split(' Şubeleri')[0], icon: s.icon })) || [];
---

<section id="kurumsal" class="relative overflow-hidden bg-gradient-to-br from-primary to-primary-dark text-white">
  <!-- Decorative blurred circles -->
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute -top-24 right-0 w-[500px] h-[500px] bg-accent/[0.06] rounded-full blur-3xl translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-secondary/[0.06] rounded-full blur-3xl -translate-x-1/4 translate-y-1/4"></div>
  </div>

  <div class="section-container section-padding relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Left: Content -->
      <div>
        <span class="badge bg-white/10 text-white/90 backdrop-blur-sm mb-4">Kurumsal Hizmetler</span>
        <h2 class="text-section font-bold text-white mb-6">{corporateConfig?.title}</h2>
        <p class="text-white/75 leading-relaxed mb-8">
          {corporateConfig?.description}
        </p>

        <ul class="space-y-3 mb-8">
          {corporateConfig?.bulletPoints?.map((point: string) => (
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <span class="text-white/80">{point}</span>
            </li>
          ))}
        </ul>

        <a href="/kurumsal/" class="btn-secondary !bg-transparent !border-white/30 !text-white hover:!bg-white hover:!text-primary">
          Kurumsal Çözümler
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>

      <!-- Right: Sector mini cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {sectors.map((sector) => (
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 text-center hover:bg-white/15 transition-colors duration-200">
            <div class="w-12 h-12 mx-auto mb-2 rounded-xl bg-white/10 flex items-center justify-center">
              {sector.icon === 'building' && (
                <svg class="w-6 h-6 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16"/>
                  <path d="M3 21h18"/>
                  <path d="M9 7h1M9 11h1M9 15h1M14 7h1M14 11h1M14 15h1"/>
                </svg>
              )}
              {sector.icon === 'utensils' && (
                <svg class="w-6 h-6 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
                  <path d="M7 2v20"/>
                  <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
                </svg>
              )}
              {sector.icon === 'briefcase' && (
                <svg class="w-6 h-6 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
              )}
              {sector.icon === 'store' && (
                <svg class="w-6 h-6 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/>
                  <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                  <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/>
                  <path d="M2 7h20"/>
                  <path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12v0a2 2 0 0 1-2-2V7"/>
                </svg>
              )}
              {sector.icon === 'dumbbell' && (
                <svg class="w-6 h-6 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6.5 6.5 11 11"/>
                  <path d="m21 21-1-1"/>
                  <path d="m3 3 1 1"/>
                  <path d="m18 22 4-4"/>
                  <path d="m2 6 4-4"/>
                  <path d="m3 10 7-7"/>
                  <path d="m14 21 7-7"/>
                </svg>
              )}
              {sector.icon === 'bank' && (
                <svg class="w-6 h-6 text-accent-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3"/>
                </svg>
              )}
            </div>
            <span class="text-white text-sm font-medium">{sector.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
