---
import config from '../../config/site.config.json';

const { whatsapp } = config.contact;
const whatsappClean = whatsapp.replace(/[\s+]/g, '');
const whatsappUrl = `https://wa.me/${whatsappClean}`;
---

<div class="fixed bottom-6 right-6 z-40" id="whatsapp-cta">
  {/* Tooltip */}
  <span
    class="wa-tooltip absolute right-[calc(100%+12px)] top-1/2 -translate-y-1/2 whitespace-nowrap bg-white text-primary text-sm font-semibold px-4 py-2 rounded-lg shadow-elevated pointer-events-none"
    aria-hidden="true"
  >
    WhatsApp ile Yazın
  </span>

  {/* Pulse ring */}
  <span class="absolute inset-0 rounded-full bg-[#25D366]/40 animate-[whatsapp-ping_2.5s_cubic-bezier(0,0,0.2,1)_3]" aria-hidden="true"></span>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="relative w-14 h-14 rounded-full bg-[#166B34] text-white flex items-center justify-center shadow-elevated hover:scale-110 transition-transform duration-200 animate-[whatsapp-bounce_0.6s_ease-out_0.5s_both]"
    aria-label="WhatsApp ile iletişime geçin"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.611.611l4.458-1.495A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.387 0-4.607-.798-6.382-2.147l-.362-.282-3.448 1.156 1.156-3.448-.282-.362A9.935 9.935 0 012 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/>
    </svg>
  </a>
</div>

<style>
  .wa-tooltip {
    opacity: 0;
    animation: wa-tooltip-show 0.4s ease-out 1.5s forwards, wa-tooltip-hide 0.3s ease-in 4s forwards;
  }

  @keyframes wa-tooltip-show {
    to { opacity: 1; }
  }
  @keyframes wa-tooltip-hide {
    to { opacity: 0; }
  }

  @keyframes whatsapp-ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70%, 100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @keyframes whatsapp-bounce {
    0% {
      opacity: 0;
      transform: scale(0.3) translateY(20px);
    }
    50% {
      opacity: 1;
      transform: scale(1.08) translateY(-4px);
    }
    70% {
      transform: scale(0.96) translateY(2px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
</style>
